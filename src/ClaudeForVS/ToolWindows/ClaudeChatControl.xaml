<UserControl x:Class="ClaudeForVS.ToolWindows.ClaudeChatControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vsshell="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
             xmlns:platform="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
             xmlns:md="clr-namespace:ClaudeForVS.Markdown"
             Background="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBackgroundKey}}"
             Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <Style TargetType="Button" BasedOn="{StaticResource {x:Static vsshell:VsResourceKeys.ButtonStyleKey}}">
      <Setter Property="Margin" Value="4,0,0,0" />
      <Setter Property="Padding" Value="8,2" />
      <Setter Property="MinWidth" Value="0" />
    </Style>
    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Static vsshell:VsResourceKeys.TextBoxStyleKey}}" />
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}" />
    </Style>
    <Style TargetType="Hyperlink">
      <Setter Property="Foreground" Value="{DynamicResource {x:Static platform:EnvironmentColors.ControlLinkTextBrushKey}}" />
    </Style>
    <Style x:Key="MonoBox" TargetType="TextBox" BasedOn="{StaticResource {x:Static vsshell:VsResourceKeys.TextBoxStyleKey}}">
      <Setter Property="IsReadOnly" Value="True" />
      <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="4" />
      <Setter Property="TextWrapping" Value="NoWrap" />
      <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
      <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
      <Setter Property="Background" Value="{DynamicResource {x:Static vsshell:VsBrushes.WindowKey}}" />
      <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.WindowTextKey}}" />
    </Style>
  </UserControl.Resources>

  <Grid Margin="6">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Repository picker -->
    <DockPanel Grid.Row="0" Margin="0,0,0,4">
      <TextBlock DockPanel.Dock="Left" Text="Repo:" VerticalAlignment="Center" Margin="0,0,4,0" />
      <Button DockPanel.Dock="Right" Content="New chat" Click="OnNewChat" ToolTip="Start a fresh conversation" />
      <Button DockPanel.Dock="Right" Content="From solution" Click="OnFromSolution" ToolTip="Use the git repository of the open solution" />
      <TextBox Text="{Binding RepoPath, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" />
    </DockPanel>

    <!-- API key setup -->
    <Border Grid.Row="1" Margin="0,0,0,4" Padding="6" BorderThickness="1"
            BorderBrush="{DynamicResource {x:Static vsshell:VsBrushes.ActiveBorderKey}}"
            Visibility="{Binding NeedsApiKey, Converter={StaticResource BoolToVis}}">
      <StackPanel>
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                   Text="Enter your Anthropic API key (from console.anthropic.com). It's stored encrypted for your Windows account in %LOCALAPPDATA%\ClaudeForVS." />
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="Save key" Click="OnSaveKey" />
          <PasswordBox x:Name="ApiKeyBox" VerticalContentAlignment="Center" />
        </DockPanel>
      </StackPanel>
    </Border>

    <!-- Transcript -->
    <ScrollViewer x:Name="Transcript" Grid.Row="2"
                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  ScrollChanged="OnTranscriptScrollChanged" PreviewMouseWheel="OnTranscriptMouseWheel">
      <ItemsControl ItemsSource="{Binding Messages}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border x:Name="Card" Margin="0,0,0,8" Padding="8,4" BorderThickness="2,0,0,0"
                    BorderBrush="{DynamicResource {x:Static vsshell:VsBrushes.ActiveBorderKey}}">
              <StackPanel>
                <TextBlock x:Name="HeaderText" Text="{Binding Header}" FontWeight="SemiBold" Margin="0,0,0,2" TextWrapping="Wrap" />
                <md:MarkdownView x:Name="Body" Markdown="{Binding Text, Mode=OneWay}"
                                 Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}" />
                <TextBlock x:Name="PlainBody" Text="{Binding Text}" TextWrapping="Wrap" Visibility="Collapsed" />
                <Expander x:Name="DetailExpander" Header="Details" Margin="0,2,0,0"
                          Foreground="{DynamicResource {x:Static vsshell:VsBrushes.GrayTextKey}}"
                          Visibility="{Binding HasDetail, Converter={StaticResource BoolToVis}}">
                  <TextBox Style="{StaticResource MonoBox}" Text="{Binding Detail, Mode=OneWay}" />
                </Expander>
              </StackPanel>
            </Border>
            <DataTemplate.Triggers>
              <DataTrigger Binding="{Binding Kind}" Value="User">
                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource {x:Static platform:EnvironmentColors.SystemHighlightBrushKey}}" />
              </DataTrigger>
              <DataTrigger Binding="{Binding Kind}" Value="Thinking">
                <Setter TargetName="Body" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="PlainBody" Property="Visibility" Value="Visible" />
                <Setter TargetName="PlainBody" Property="FontStyle" Value="Italic" />
                <Setter TargetName="PlainBody" Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.GrayTextKey}}" />
                <Setter TargetName="HeaderText" Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.GrayTextKey}}" />
              </DataTrigger>
              <DataTrigger Binding="{Binding Kind}" Value="Tool">
                <Setter TargetName="Body" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="HeaderText" Property="FontFamily" Value="Cascadia Mono, Consolas" />
                <Setter TargetName="HeaderText" Property="FontWeight" Value="Normal" />
                <Setter TargetName="HeaderText" Property="FontSize" Value="11" />
              </DataTrigger>
              <DataTrigger Binding="{Binding Kind}" Value="Error">
                <Setter TargetName="Body" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="PlainBody" Property="Visibility" Value="Visible" />
                <Setter TargetName="Card" Property="BorderBrush" Value="Firebrick" />
              </DataTrigger>
            </DataTemplate.Triggers>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <!-- Approval prompt for actions that change the repository -->
    <Border Grid.Row="3" Margin="0,4,0,0" Padding="6" BorderThickness="1" BorderBrush="Orange"
            Visibility="{Binding HasPendingApproval, Converter={StaticResource BoolToVis}}">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Claude wants to:" Margin="0,0,0,2" />
        <TextBlock DockPanel.Dock="Top" Text="{Binding ApprovalTitle}" FontFamily="Cascadia Mono, Consolas" FontWeight="SemiBold" TextWrapping="Wrap" />
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
          <Button Content="Allow" Click="OnAllow" />
          <Button Content="{Binding AllowAllLabel}" Click="OnAllowAll" Visibility="{Binding CanAllowAll, Converter={StaticResource BoolToVis}}" />
          <Button Content="Deny" Click="OnDeny" />
        </StackPanel>
        <TextBox Style="{StaticResource MonoBox}" Text="{Binding ApprovalDetail, Mode=OneWay}" Margin="0,4,0,0"
                 MaxHeight="240" VerticalScrollBarVisibility="Auto"
                 Visibility="{Binding HasApprovalDetail, Converter={StaticResource BoolToVis}}" />
      </DockPanel>
    </Border>

    <!-- Status line -->
    <DockPanel Grid.Row="4" Margin="0,4,0,0">
      <Button DockPanel.Dock="Right" Content="Change API key" Click="OnChangeKey"
              Visibility="{Binding HasApiKey, Converter={StaticResource BoolToVis}}" />
      <TextBlock Text="{Binding Status}" TextWrapping="Wrap" VerticalAlignment="Center"
                 Foreground="{DynamicResource {x:Static vsshell:VsBrushes.GrayTextKey}}" />
    </DockPanel>

    <!-- Prompt box: Enter sends, Shift+Enter inserts a new line -->
    <DockPanel Grid.Row="5" Margin="0,4,0,0">
      <StackPanel DockPanel.Dock="Right" VerticalAlignment="Bottom">
        <Button Content="Send" Click="OnSend" IsEnabled="{Binding IsIdle}" Margin="4,0,0,4" />
        <Button Content="Stop" Click="OnStop" IsEnabled="{Binding IsBusy}" />
      </StackPanel>
      <TextBox x:Name="PromptBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" MaxHeight="200"
               VerticalScrollBarVisibility="Auto" PreviewKeyDown="OnPromptKeyDown"
               ToolTip="Enter to send, Shift+Enter for a new line" />
    </DockPanel>
  </Grid>
</UserControl>
