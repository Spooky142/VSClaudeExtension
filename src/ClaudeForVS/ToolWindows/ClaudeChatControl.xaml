<UserControl x:Class="ClaudeForVS.ToolWindows.ClaudeChatControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vsshell="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
             xmlns:platform="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
             xmlns:md="clr-namespace:ClaudeForVS.Markdown"
             xmlns:local="clr-namespace:ClaudeForVS.ToolWindows"
             Background="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBackgroundKey}}"
             Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"
             FontFamily="{DynamicResource {x:Static vsshell:VsFonts.EnvironmentFontFamilyKey}}"
             FontSize="12">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Theme.xaml" />
      </ResourceDictionary.MergedDictionaries>

    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <local:EmptyToVisibilityConverter x:Key="EmptyToVis" />

    <!-- Whole-row toggle used by collapsible transcript rows. -->
    <Style x:Key="RowToggle" TargetType="ToggleButton">
      <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="Bd" Background="Transparent" CornerRadius="6">
              <ContentPresenter HorizontalAlignment="Stretch" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverTint}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Cursor" Value="Arrow" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Whole-card button for a saved chat in the History tab. -->
    <Style x:Key="SessionRow" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="10,8">
              <ContentPresenter HorizontalAlignment="Stretch" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverTint}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PressTint}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- A file in the files-changed row; clicking it opens the file's diff. -->
    <Style x:Key="FileRow" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="Transparent" Padding="10,3">
              <ContentPresenter HorizontalAlignment="Stretch" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverTint}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PressTint}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Cursor" Value="Arrow" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- A line of an edit on the approval card when changes can be kept or left out: a checkbox on each block's first line. -->
    <DataTemplate x:Key="ReviewLineTemplate">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="24" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <CheckBox VerticalAlignment="Top" Margin="6,1,0,0" IsChecked="{Binding Block.IsKept, Mode=TwoWay}"
                  Visibility="{Binding ShowToggle, Converter={StaticResource BoolToVis}}" ToolTip="Keep this change (untick to leave it out)" />
        <Border x:Name="Bg" Grid.Column="1" Padding="8,0">
          <TextBlock x:Name="LineText" Text="{Binding Text}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" TextWrapping="Wrap" />
        </Border>
      </Grid>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Kind}" Value="Added">
          <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AddedTint}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Kind}" Value="Removed">
          <Setter TargetName="Bg" Property="Background" Value="{DynamicResource RemovedTint}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Kind}" Value="Hunk">
          <Setter TargetName="LineText" Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.GrayTextKey}}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Block.IsKept}" Value="False">
          <Setter TargetName="Bg" Property="Opacity" Value="0.45" />
          <Setter TargetName="LineText" Property="TextDecorations" Value="Strikethrough" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- ===== Transcript templates ===== -->
    <DataTemplate x:Key="UserTemplate">
      <!-- Left-anchored 48px in from the edge; shrinks to fit short messages and grows rightward for long ones.
           What was attached sits under the bubble, and Edit / Retry / Undo appear on hover. -->
      <StackPanel x:Name="Root" Margin="48,10,0,0" HorizontalAlignment="Left" Background="Transparent">
        <Border HorizontalAlignment="Left" CornerRadius="12,12,4,12" Padding="12,8"
                Background="{DynamicResource UserBubble}" BorderThickness="1" BorderBrush="{DynamicResource UserBubbleBorder}">
          <md:MarkdownView Markdown="{Binding Text, Mode=OneWay}" FontSize="13"
                           Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}" />
        </Border>
        <StackPanel Orientation="Horizontal" Margin="6,3,0,0" Visibility="{Binding HasNote, Converter={StaticResource BoolToVis}}">
          <TextBlock Style="{StaticResource Icon}" Text="&#xE723;" FontSize="10" Margin="0,0,4,0" />
          <TextBlock Text="{Binding Note}" Style="{StaticResource Muted}" FontSize="10.5" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <TextBlock Style="{StaticResource Icon}" Text="&#xE735;" FontSize="11" Foreground="{DynamicResource Accent}" Margin="6,3,0,0"
                   ToolTip="Starred" AutomationProperties.Name="Starred message"
                   Visibility="{Binding IsStarred, Converter={StaticResource BoolToVis}}" />
        <StackPanel x:Name="Actions" Orientation="Horizontal" Margin="0,1,0,0" Visibility="Hidden">
          <Button Style="{StaticResource MiniButton}" Content="Edit" Click="OnEditPrompt"
                  ToolTip="Take this message and Claude's replies after it out of the chat, and edit it" />
          <Button Style="{StaticResource MiniButton}" Content="Retry" Click="OnRetryPrompt"
                  ToolTip="Take Claude's replies to this message out of the chat and send it again" />
          <Button Style="{StaticResource MiniButton}" Content="Undo changes" Click="OnUndoPrompt"
                  ToolTip="Put the files Claude changed since this message back the way they were"
                  Visibility="{Binding CanUndo, Converter={StaticResource BoolToVis}}" />
          <Button Style="{StaticResource MiniButton}" Content="Branch" Click="OnBranchPrompt"
                  ToolTip="Open a copy of this chat as it was before this message in a new window, to try a different way forward" />
          <Button Style="{StaticResource MiniButton}" Content="{Binding StarText}" Click="OnToggleStar"
                  ToolTip="Star this message to find it again from the star menu in the header" />
          <Button Style="{StaticResource MiniButton}" Content="Copy" Click="OnCopyEntry" ToolTip="Copy this message" />
        </StackPanel>
      </StackPanel>
      <DataTemplate.Triggers>
        <MultiDataTrigger>
          <MultiDataTrigger.Conditions>
            <Condition Binding="{Binding IsMouseOver, ElementName=Root}" Value="True" />
            <Condition Binding="{Binding DataContext.IsIdle, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True" />
          </MultiDataTrigger.Conditions>
          <Setter TargetName="Actions" Property="Visibility" Value="Visible" />
        </MultiDataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate x:Key="AssistantTemplate">
      <Border x:Name="Bubble" Margin="0,10,24,6" HorizontalAlignment="Left" CornerRadius="12,12,12,4" Padding="12,10"
              Background="{DynamicResource SubtleFill}" BorderThickness="1" BorderBrush="{DynamicResource SubtleBorder}">
        <StackPanel>
          <DockPanel Margin="0,0,0,6">
            <Button x:Name="CopyReply" DockPanel.Dock="Right" Style="{StaticResource MiniButton}" Content="Copy" Margin="12,0,0,0"
                    Click="OnCopyEntry" ToolTip="Copy this reply as Markdown" Visibility="Hidden" />
            <Button x:Name="StarReply" DockPanel.Dock="Right" Style="{StaticResource MiniButton}" Content="{Binding StarText}" Margin="12,0,0,0"
                    Click="OnToggleStar" ToolTip="Star this reply to find it again from the star menu in the header" Visibility="Hidden" />
            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Icon}" Text="&#xE735;" FontSize="11" Foreground="{DynamicResource Accent}"
                       VerticalAlignment="Center" ToolTip="Starred" AutomationProperties.Name="Starred message"
                       Visibility="{Binding IsStarred, Converter={StaticResource BoolToVis}}" />
            <StackPanel Orientation="Horizontal">
              <Border Width="20" Height="20" CornerRadius="10" Background="{DynamicResource Accent}">
                <TextBlock Text="✻" Foreground="{DynamicResource OnAccent}" FontSize="12" FontFamily="Segoe UI Symbol"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" />
              </Border>
              <TextBlock Text="Claude" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
          </DockPanel>
          <md:MarkdownView Markdown="{Binding Text, Mode=OneWay}" FontSize="13"
                           Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}" />
        </StackPanel>
      </Border>
      <DataTemplate.Triggers>
        <Trigger SourceName="Bubble" Property="IsMouseOver" Value="True">
          <Setter TargetName="CopyReply" Property="Visibility" Value="Visible" />
          <Setter TargetName="StarReply" Property="Visibility" Value="Visible" />
        </Trigger>
        <DataTrigger Binding="{Binding CanStar}" Value="False">
          <Setter TargetName="StarReply" Property="Visibility" Value="Collapsed" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Marks where Claude thought; a label only, without the reasoning itself. -->
    <DataTemplate x:Key="ThinkingTemplate">
      <StackPanel Orientation="Horizontal" Margin="6,8,0,6">
        <TextBlock Style="{StaticResource Icon}" FontSize="12" Text="&#xEA80;" Margin="0,0,8,0" />
        <TextBlock Text="Thinking" FontStyle="Italic" Style="{StaticResource Muted}" VerticalAlignment="Center" />
      </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="ToolTemplate">
      <Border Margin="0,2,24,2" HorizontalAlignment="Left" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource SubtleBorder}" Background="{DynamicResource SubtleFill}">
        <StackPanel>
          <DockPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource MiniButton}" Content="Diff" Margin="0,0,4,0" VerticalAlignment="Center"
                    Click="OnOpenEntryDiff" ToolTip="Open this change in Visual Studio's diff viewer"
                    Visibility="{Binding HasChange, Converter={StaticResource BoolToVis}}" />
            <Button DockPanel.Dock="Right" Style="{StaticResource MiniButton}" Content="Stop" Margin="0,0,4,0" VerticalAlignment="Center"
                    Click="OnStopEntry" ToolTip="Stop this; Claude carries on without it"
                    Visibility="{Binding LiveTask.CanStop, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}" />
            <Button DockPanel.Dock="Right" Style="{StaticResource MiniButton}" Content="Show" Margin="0,0,2,0" VerticalAlignment="Center"
                    Click="OnShowEntryTask" ToolTip="Watch this in the Claude Tasks window"
                    Visibility="{Binding IsLive, Converter={StaticResource BoolToVis}}" />
            <TextBlock DockPanel.Dock="Right" Text="{Binding LiveTask.StatusText}" Style="{StaticResource Muted}" FontSize="11"
                       Margin="8,0,6,0" VerticalAlignment="Center" Visibility="{Binding IsLive, Converter={StaticResource BoolToVis}}" />
            <ToggleButton x:Name="Toggle" Style="{StaticResource RowToggle}" IsEnabled="{Binding HasDetail}">
              <DockPanel Margin="8,5">
                <TextBlock x:Name="Chevron" DockPanel.Dock="Right" Style="{StaticResource Icon}" FontSize="9" Text="&#xE76C;"
                           Margin="8,0,0,0" Visibility="{Binding HasDetail, Converter={StaticResource BoolToVis}}" />
                <TextBlock x:Name="Glyph" Style="{StaticResource Icon}" FontSize="12" Text="&#xE756;" Margin="0,0,8,0" />
                <TextBlock x:Name="Title" Text="{Binding Header}" ToolTip="{Binding Header}" FontFamily="{StaticResource MonoFont}"
                           FontSize="11.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
              </DockPanel>
            </ToggleButton>
          </DockPanel>
          <Border x:Name="Details" Visibility="Collapsed" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource SubtleBorder}" Padding="0,4">
            <ItemsControl ItemsSource="{Binding DetailLines}" ItemTemplate="{StaticResource DiffLineTemplate}" />
          </Border>
        </StackPanel>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsChecked, ElementName=Toggle}" Value="True">
          <Setter TargetName="Details" Property="Visibility" Value="Visible" />
          <Setter TargetName="Chevron" Property="Text" Value="&#xE70D;" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Activity}" Value="Read">
          <Setter TargetName="Glyph" Property="Text" Value="&#xE8A5;" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Activity}" Value="Edit">
          <Setter TargetName="Glyph" Property="Text" Value="&#xE70F;" />
          <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Accent}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Activity}" Value="Create">
          <Setter TargetName="Glyph" Property="Text" Value="&#xE710;" />
          <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Accent}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Activity}" Value="Declined">
          <Setter TargetName="Glyph" Property="Text" Value="&#xE711;" />
          <Setter TargetName="Title" Property="TextDecorations" Value="Strikethrough" />
          <Setter TargetName="Title" Property="Opacity" Value="0.6" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Activity}" Value="Failed">
          <Setter TargetName="Glyph" Property="Text" Value="&#xE7BA;" />
          <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Amber}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Activity}" Value="Search">
          <Setter TargetName="Glyph" Property="Text" Value="&#xE721;" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Activity}" Value="Web">
          <Setter TargetName="Glyph" Property="Text" Value="&#xE774;" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Activity}" Value="Other">
          <Setter TargetName="Glyph" Property="Text" Value="&#xE946;" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Activity}" Value="Question">
          <Setter TargetName="Glyph" Property="Text" Value="&#xE897;" />
          <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Accent}" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate x:Key="ErrorTemplate">
      <Border Margin="0,6" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource ErrorRed}" Background="{DynamicResource ErrorTint}" Padding="10,8">
        <DockPanel>
          <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE783;" FontSize="14"
                     Foreground="{DynamicResource ErrorRed}" VerticalAlignment="Top" Margin="0,1,10,0" />
          <StackPanel>
            <TextBlock Text="{Binding Header}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="0,2,0,0" Style="{StaticResource Muted}" />
          </StackPanel>
        </DockPanel>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="NoticeTemplate">
      <Grid Margin="0,10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Height="1" Background="{DynamicResource SubtleBorder}" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="{Binding Header}" Style="{StaticResource Muted}" FontSize="11" Margin="10,0" VerticalAlignment="Center" />
          <Button Style="{StaticResource MiniButton}" Content="Restore files" Click="OnRestorePoint" Margin="0,0,10,0"
                  ToolTip="Put every file back the way it was at this restore point. The conversation is left as it is."
                  Visibility="{Binding IsRestorePoint, Converter={StaticResource BoolToVis}}" />
        </StackPanel>
        <Border Grid.Column="2" Height="1" Background="{DynamicResource SubtleBorder}" VerticalAlignment="Center" />
      </Grid>
    </DataTemplate>

    <!-- The prompt's token count, on its own line tucked under the last thing Claude wrote. -->
    <DataTemplate x:Key="UsageTemplate">
      <TextBlock Text="{Binding Text}" Style="{StaticResource Muted}" FontSize="10.5" HorizontalAlignment="Left" Margin="12,0,0,10" />
    </DataTemplate>

    <!-- The files a prompt changed: "3 files changed +42 −10", expanding to one row per file that opens its diff. -->
    <DataTemplate x:Key="ChangesTemplate">
      <Border Margin="0,4,24,4" HorizontalAlignment="Left" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource SubtleBorder}" Background="{DynamicResource SubtleFill}">
        <StackPanel>
          <ToggleButton x:Name="Toggle" Style="{StaticResource RowToggle}" ToolTip="Show the files Claude changed">
            <DockPanel Margin="8,5">
              <TextBlock x:Name="Chevron" DockPanel.Dock="Right" Style="{StaticResource Icon}" FontSize="9" Text="&#xE76C;" Margin="10,0,0,0" />
              <TextBlock Style="{StaticResource Icon}" FontSize="12" Text="&#xE70F;" Foreground="{DynamicResource Accent}" Margin="0,0,8,0" />
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding FilesChangedText}" FontSize="11.5" />
                <TextBlock Text="{Binding AddedText}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" Foreground="{DynamicResource AddedGreen}" Margin="10,0,0,0" />
                <TextBlock Text="{Binding RemovedText}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" Foreground="{DynamicResource RemovedRed}" Margin="6,0,0,0" />
              </StackPanel>
            </DockPanel>
          </ToggleButton>
          <Border x:Name="Details" Visibility="Collapsed" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource SubtleBorder}" Padding="0,3">
            <ItemsControl ItemsSource="{Binding FileRows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource MiniButton}" Content="Revert" Margin="2,0,4,0" VerticalAlignment="Center"
                            Click="OnRevertChangedFile" ToolTip="Put just this file back the way it was before the message" />
                    <Button Style="{StaticResource FileRow}" Click="OnOpenChangedFile" IsEnabled="{Binding CanDiff}"
                            ToolTip="{Binding StatusText}">
                      <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding RemovedText}" FontFamily="{StaticResource MonoFont}" FontSize="11"
                                   Foreground="{DynamicResource RemovedRed}" Margin="6,0,0,0" />
                        <TextBlock DockPanel.Dock="Right" Text="{Binding AddedText}" FontFamily="{StaticResource MonoFont}" FontSize="11"
                                   Foreground="{DynamicResource AddedGreen}" Margin="12,0,0,0" />
                        <TextBlock x:Name="FilePath" Text="{Binding Path}" FontFamily="{StaticResource MonoFont}" FontSize="11.5"
                                   TextTrimming="CharacterEllipsis" />
                      </DockPanel>
                    </Button>
                  </DockPanel>
                  <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Stat.Status}" Value="D">
                      <Setter TargetName="FilePath" Property="TextDecorations" Value="Strikethrough" />
                      <Setter TargetName="FilePath" Property="Opacity" Value="0.7" />
                    </DataTrigger>
                  </DataTemplate.Triggers>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Border>
        </StackPanel>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsChecked, ElementName=Toggle}" Value="True">
          <Setter TargetName="Details" Property="Visibility" Value="Visible" />
          <Setter TargetName="Chevron" Property="Text" Value="&#xE70D;" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- An attachment above the prompt box: image thumbnail or icon, label, and × to remove it. -->
    <DataTemplate x:Key="AttachmentChip">
      <Border Margin="0,0,6,6" CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource SubtleBorder}"
              Background="{DynamicResource SubtleFill}" Padding="7,2,2,2" ToolTip="{Binding ToolTip}">
        <StackPanel Orientation="Horizontal">
          <Image Source="{Binding Thumbnail}" Height="18" MaxWidth="36" Margin="0,0,5,0" Stretch="Uniform"
                 Visibility="{Binding HasThumbnail, Converter={StaticResource BoolToVis}}" />
          <TextBlock Text="{Binding Glyph}" FontSize="11" Margin="0,0,5,0">
            <TextBlock.Style>
              <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding HasThumbnail}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <TextBlock Text="{Binding Label}" FontSize="11.5" VerticalAlignment="Center" MaxWidth="240" TextTrimming="CharacterEllipsis" />
          <Button Style="{StaticResource ChipCloseButton}" Content="&#xE711;" Click="OnRemoveAttachment" AutomationProperties.Name="Leave this out" ToolTip="Leave this out" />
        </StackPanel>
      </Border>
    </DataTemplate>

    <local:ChatEntryTemplateSelector x:Key="EntrySelector"
                                     User="{StaticResource UserTemplate}"
                                     Assistant="{StaticResource AssistantTemplate}"
                                     Thinking="{StaticResource ThinkingTemplate}"
                                     Tool="{StaticResource ToolTemplate}"
                                     Error="{StaticResource ErrorTemplate}"
                                     Notice="{StaticResource NoticeTemplate}"
                                     Usage="{StaticResource UsageTemplate}"
                                     Changes="{StaticResource ChangesTemplate}" />
    </ResourceDictionary>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Header: repository and model chips, actions; then the always-visible usage strip -->
    <StackPanel Grid.Row="0">
    <DockPanel Margin="10,8,10,6">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button Style="{StaticResource IconButton}" Content="&#xE7C4;" AutomationProperties.Name="Claude Tasks" ToolTip="{Binding ToolTasksTooltip}" Click="OnShowToolTasks"
                Visibility="{Binding HasToolTasks, Converter={StaticResource BoolToVis}}" />
        <Button Style="{StaticResource IconButton}" Content="&#xE734;" AutomationProperties.Name="Starred messages" ToolTip="Starred messages" Click="OnStarredMenu" />
        <Button Style="{StaticResource IconButton}" Content="&#xE721;" AutomationProperties.Name="Find in this chat (Ctrl+F)" ToolTip="Find in this chat (Ctrl+F)" Click="OnOpenFind" />
        <Button Style="{StaticResource IconButton}" Content="&#xE81C;" AutomationProperties.Name="History" ToolTip="History" Click="OnToggleHistory" />
        <Button Style="{StaticResource IconButton}" Content="&#xE710;" AutomationProperties.Name="New chat" ToolTip="New chat" Click="OnNewChat" />
        <Button Style="{StaticResource IconButton}" Content="&#xE78B;" AutomationProperties.Name="New chat window" ToolTip="Open another chat window, to work on something else alongside this chat" Click="OnNewChatWindow" />
        <Button Style="{StaticResource IconButton}" Content="&#xE703;" AutomationProperties.Name="MCP servers" ToolTip="MCP servers: turn them on or off and see whether they work" Click="OnOpenMcpServers" />
        <Button Style="{StaticResource IconButton}" Content="&#xE713;" AutomationProperties.Name="Settings" ToolTip="Settings" Click="OnOpenSettings" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
        <Button Style="{StaticResource OutlineButton}" Margin="0" Padding="10,4" ToolTip="{Binding RepoTooltip}" Click="OnOpenSettings">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" FontSize="12" Foreground="{DynamicResource Accent}" />
            <TextBlock Text="{Binding RepoName}" FontWeight="SemiBold" Margin="7,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button x:Name="ModelChip" Style="{StaticResource OutlineButton}" Margin="6,0,0,0" Padding="10,4" ToolTip="Change model, effort or mode" Click="OnModelMenu">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE945;" FontSize="12" Foreground="{DynamicResource Accent}" />
            <TextBlock Text="{Binding ModelSummary}" Margin="7,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button x:Name="SubagentChip" Style="{StaticResource OutlineButton}" Margin="6,0,0,0" Padding="10,4"
                ToolTip="Change the model and effort of the subagents Claude starts for scoped jobs" Click="OnSubagentMenu">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE902;" FontSize="12" Foreground="{DynamicResource Accent}" />
            <TextBlock Text="Subagents" Style="{StaticResource Muted}" Margin="7,0,0,0" VerticalAlignment="Center" />
            <TextBlock Text="{Binding SubagentSummary}" Margin="6,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button x:Name="DevActionsChip" Style="{StaticResource OutlineButton}" Margin="6,0,0,0" Padding="10,4"
                ToolTip="Ask Claude to do a git job: resolve conflicts, review staged changes or write a commit message" Click="OnDevActionsMenu">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE90F;" FontSize="12" Foreground="{DynamicResource Accent}" />
            <TextBlock Text="Developer actions" Margin="7,0,0,0" VerticalAlignment="Center" />
            <TextBlock Style="{StaticResource Icon}" Text="&#xE70D;" FontSize="8" Margin="6,1,0,0" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </StackPanel>
    </DockPanel>

    <!-- Usage strip: plan limits (Claude Code) or session tokens and rate limits (Claude API). Always shown. -->
    <Border Margin="10,0,10,8">
      <Grid>
        <!-- One row of tiles, or a 2x2 grid when there are four. The -3 margin cancels the tiles' outer spacing. -->
        <ItemsControl ItemsSource="{Binding UsageMeters}" Margin="-3" Visibility="{Binding HasUsageMeters, Converter={StaticResource BoolToVis}}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="{Binding UsageColumns}" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Margin="3" Padding="10,6,10,6" CornerRadius="8" BorderThickness="1"
                      BorderBrush="{DynamicResource SubtleBorder}" Background="{DynamicResource SubtleFill}"
                      ToolTip="{Binding Detail}">
                <StackPanel>
                  <DockPanel>
                    <TextBlock x:Name="ValueText" DockPanel.Dock="Right" Text="{Binding Value}" FontWeight="SemiBold" FontSize="11.5" />
                    <TextBlock Text="{Binding Label}" Style="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,0,6,0" />
                  </DockPanel>
                  <ProgressBar x:Name="Bar" Style="{StaticResource MeterBar}" Value="{Binding BarValue, Mode=OneWay}" Margin="0,5,0,3"
                               Visibility="{Binding HasBar, Converter={StaticResource BoolToVis}}" />
                  <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" FontSize="10.5" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                </StackPanel>
              </Border>
              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Severity}" Value="Warning">
                  <Setter TargetName="Bar" Property="Foreground" Value="{DynamicResource Amber}" />
                  <Setter TargetName="ValueText" Property="Foreground" Value="{DynamicResource Amber}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="Critical">
                  <Setter TargetName="Bar" Property="Foreground" Value="{DynamicResource ErrorRed}" />
                  <Setter TargetName="ValueText" Property="Foreground" Value="{DynamicResource ErrorRed}" />
                </DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <DockPanel Margin="2,0,0,0">
          <DockPanel.Style>
            <Style TargetType="DockPanel">
              <Style.Triggers>
                <DataTrigger Binding="{Binding HasUsageMeters}" Value="True">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </DockPanel.Style>
          <TextBlock Style="{StaticResource Icon}" Text="&#xE9D9;" FontSize="11" Margin="0,0,6,0" />
          <TextBlock Text="{Binding UsageEmptyText}" Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" />
        </DockPanel>
      </Grid>
    </Border>

    </StackPanel>

    <!-- History tab: saved chats, newest first. Click one to continue it; the row's buttons rename, export or delete it. -->
    <Grid Grid.Row="1" Visibility="{Binding ShowHistory, Converter={StaticResource BoolToVis}}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <DockPanel Margin="14,0,12,6">
        <Button DockPanel.Dock="Right" Style="{StaticResource OutlineButton}" Padding="10,3" Content="Delete all" Click="OnDeleteAllSessions"
                ToolTip="Delete every chat shown below, except pinned ones" Visibility="{Binding HasSessions, Converter={StaticResource BoolToVis}}" />
        <TextBlock Text="Previous chats" FontWeight="SemiBold" VerticalAlignment="Center" />
      </DockPanel>
      <DockPanel Grid.Row="1" Margin="12,0,12,8">
        <CheckBox DockPanel.Dock="Right" Content="This repository only" IsChecked="{Binding ThisRepoOnly}" VerticalAlignment="Center" Margin="10,0,0,0"
                  Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}" />
        <Grid>
          <TextBox x:Name="SessionSearchBox" AutomationProperties.Name="Search chats" Style="{StaticResource Field}" Text="{Binding SessionSearch, UpdateSourceTrigger=PropertyChanged, Delay=250}" />
          <TextBlock Text="Search titles, repositories and messages…" IsHitTestVisible="False" Style="{StaticResource Muted}" Margin="8,5,0,0"
                     Visibility="{Binding Text, ElementName=SessionSearchBox, Converter={StaticResource EmptyToVis}}" />
        </Grid>
      </DockPanel>
      <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <ItemsControl ItemsSource="{Binding Sessions}" Margin="10,0,10,8">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border x:Name="Card" Margin="0,0,0,6" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource SubtleBorder}"
                      Background="{DynamicResource SubtleFill}">
                <DockPanel>
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,4,0">
                    <Button Style="{StaticResource IconButton}" Content="{Binding PinGlyph}" AutomationProperties.Name="{Binding PinToolTip}" ToolTip="{Binding PinToolTip}" Click="OnPinSession" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE8AC;" AutomationProperties.Name="Rename" ToolTip="Rename" Click="OnRenameSession" />
                    <Button Style="{StaticResource IconButton}" Content="&#xEDE1;" AutomationProperties.Name="Export as Markdown" ToolTip="Export as Markdown" Click="OnExportSession" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE74D;" AutomationProperties.Name="Delete this chat" ToolTip="Delete this chat" Click="OnDeleteSession" />
                  </StackPanel>
                  <Grid>
                    <Button Style="{StaticResource SessionRow}" Click="OnOpenSession" ToolTip="{Binding Tooltip}"
                            Visibility="{Binding IsNotRenaming, Converter={StaticResource BoolToVis}}">
                      <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding TimeText}" Style="{StaticResource Muted}" FontSize="11"
                                   VerticalAlignment="Top" Margin="8,2,0,0" />
                        <StackPanel>
                          <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE840;" FontSize="11" Margin="0,0,6,0"
                                       Foreground="{DynamicResource Accent}" VerticalAlignment="Center" ToolTip="Pinned"
                                       Visibility="{Binding IsPinned, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                          </DockPanel>
                          <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis"
                                     Margin="0,2,0,0" />
                        </StackPanel>
                      </DockPanel>
                    </Button>
                    <TextBox AutomationProperties.Name="Chat title" Style="{StaticResource Field}" Margin="8,8,4,8" Text="{Binding EditTitle, UpdateSourceTrigger=PropertyChanged}"
                             Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVis}}"
                             IsVisibleChanged="OnRenameBoxVisible" KeyDown="OnRenameKeyDown" LostKeyboardFocus="OnRenameLostFocus" />
                  </Grid>
                </DockPanel>
              </Border>
              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                  <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Accent}" />
                </DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
      <DockPanel Grid.Row="2" Margin="16,8,16,0" VerticalAlignment="Top" Visibility="{Binding NoSavedSessions, Converter={StaticResource BoolToVis}}">
        <TextBlock Style="{StaticResource Icon}" Text="&#xE81C;" FontSize="12" Margin="0,0,8,0" />
        <TextBlock Text="No saved chats yet. Chats are saved automatically once you send a message." Style="{StaticResource Muted}"
                   TextWrapping="Wrap" />
      </DockPanel>
      <DockPanel Grid.Row="2" Margin="16,8,16,0" VerticalAlignment="Top" Visibility="{Binding NoSessionMatches, Converter={StaticResource BoolToVis}}">
        <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" FontSize="12" Margin="0,0,8,0" />
        <TextBlock Text="No chats match." Style="{StaticResource Muted}" TextWrapping="Wrap" />
      </DockPanel>
    </Grid>

    <!-- Chat tab: the rows below are laid out as before (row 0 is empty) -->
    <Grid Grid.Row="1" Visibility="{Binding ShowChat, Converter={StaticResource BoolToVis}}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Find bar (Ctrl+F): Enter / Shift+Enter or F3 / Shift+F3 move between matches, Esc closes it -->
    <Border x:Name="FindBar" Grid.Row="0" Margin="10,0,10,8" Padding="8,4" CornerRadius="8" BorderThickness="1"
            BorderBrush="{DynamicResource SubtleBorder}" Background="{DynamicResource SubtleFill}" Visibility="Collapsed">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock x:Name="FindCount" Style="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" Margin="8,0,6,0" />
          <Button Style="{StaticResource IconButton}" Content="&#xE70E;" AutomationProperties.Name="Previous match (Shift+Enter)" ToolTip="Previous match (Shift+Enter)" Click="OnFindPrevious" />
          <Button Style="{StaticResource IconButton}" Content="&#xE70D;" AutomationProperties.Name="Next match (Enter)" ToolTip="Next match (Enter)" Click="OnFindNext" />
          <Button Style="{StaticResource IconButton}" Content="&#xE711;" AutomationProperties.Name="Close (Esc)" ToolTip="Close (Esc)" Click="OnCloseFind" />
        </StackPanel>
        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE721;" FontSize="12" VerticalAlignment="Center" Margin="2,0,8,0" />
        <Grid>
          <TextBox x:Name="FindBox" AutomationProperties.Name="Find in this chat" Style="{StaticResource Field}" TextChanged="OnFindTextChanged" PreviewKeyDown="OnFindKeyDown" />
          <TextBlock Text="Find in this chat…" IsHitTestVisible="False" Style="{StaticResource Muted}" Margin="8,5,0,0"
                     Visibility="{Binding Text, ElementName=FindBox, Converter={StaticResource EmptyToVis}}" />
        </Grid>
      </DockPanel>
    </Border>

    <StackPanel Grid.Row="1">
      <!-- Shown until the selected engine is ready (API key saved, or Claude Code installed and signed in) -->
      <Border Margin="10,0,10,8" Padding="12,9" CornerRadius="8" BorderThickness="1"
              BorderBrush="{DynamicResource Amber}" Background="{DynamicResource AmberTint}"
              Visibility="{Binding HasSetupMessage, Converter={StaticResource BoolToVis}}">
        <DockPanel>
          <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Open settings" Click="OnOpenSettings" />
          <TextBlock Style="{StaticResource Icon}" Text="&#xE8D7;" Foreground="{DynamicResource Amber}" FontSize="13" Margin="0,0,10,0" />
          <TextBlock Text="{Binding SetupMessage}" TextWrapping="Wrap" VerticalAlignment="Center" />
        </DockPanel>
      </Border>

      <!-- Claude Code updates and newer model versions -->
      <ItemsControl ItemsSource="{Binding Banners}" Focusable="False">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Margin="10,0,10,8" Padding="12,6,4,6" CornerRadius="8" BorderThickness="1"
                    BorderBrush="{DynamicResource SubtleBorder}" Background="{DynamicResource SubtleFill}">
              <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" VerticalAlignment="Center"
                        AutomationProperties.Name="Dismiss" ToolTip="Dismiss" Click="OnDismissBanner" />
                <Button DockPanel.Dock="Right" Style="{StaticResource OutlineButton}" Margin="8,0,2,0" VerticalAlignment="Center"
                        Content="{Binding ActionText}" Click="OnBannerAction"
                        Visibility="{Binding HasAction, Converter={StaticResource BoolToVis}}" />
                <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE946;" FontSize="13" Margin="0,0,10,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" VerticalAlignment="Center" />
              </DockPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

    <!-- Transcript -->
    <ScrollViewer x:Name="Transcript" AutomationProperties.Name="Conversation" Grid.Row="2"
                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  ScrollChanged="OnTranscriptScrollChanged" PreviewMouseWheel="OnTranscriptMouseWheel">
      <ItemsControl x:Name="TranscriptItems" ItemsSource="{Binding Messages}" ItemTemplateSelector="{StaticResource EntrySelector}" Margin="12,0,12,8" />
    </ScrollViewer>

    <!-- Empty state: shown over the transcript until the chat has its first entry. -->
    <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24,0,24,24" IsHitTestVisible="False">
      <StackPanel.Style>
        <Style TargetType="StackPanel">
          <Setter Property="Visibility" Value="Collapsed" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding Messages.Count}" Value="0">
              <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </StackPanel.Style>
      <Border Width="40" Height="40" CornerRadius="20" Background="{DynamicResource Accent}" HorizontalAlignment="Center">
        <TextBlock Text="✻" Foreground="{DynamicResource OnAccent}" FontSize="22" FontFamily="Segoe UI Symbol"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0" />
      </Border>
      <TextBlock Text="What would you like to work on?" FontSize="16" FontWeight="SemiBold" TextAlignment="Center"
                 TextWrapping="Wrap" Margin="0,14,0,0" />
      <TextBlock Style="{StaticResource Muted}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0"
                 Text="Type a message below to start a chat about this repository." />
      <TextBlock Style="{StaticResource Muted}" FontSize="11" TextAlignment="Center" TextWrapping="Wrap" Margin="0,12,0,0"
                 Text="/ for commands · @ to mention a file · paste or drop images to attach them" />
    </StackPanel>

    <!-- Task list: Claude's latest TodoWrite / todo_write list. Click the header to collapse it, × to hide it. -->
    <Border Grid.Row="3" Margin="10,4,10,4" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource SubtleBorder}"
            Background="{DynamicResource SubtleFill}" Visibility="{Binding HasTasks, Converter={StaticResource BoolToVis}}">
      <StackPanel>
        <DockPanel>
          <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" Width="26" Height="26" Margin="0,0,2,0"
                  AutomationProperties.Name="Hide the task list" ToolTip="Hide the task list (it comes back when Claude updates it)" Click="OnHideTasks" />
          <ToggleButton x:Name="TasksToggle" Style="{StaticResource RowToggle}" IsChecked="{Binding TasksExpanded}" ToolTip="Show or hide the tasks">
            <DockPanel Margin="8,5">
              <TextBlock DockPanel.Dock="Right" FontSize="9" Margin="8,0,0,0" VerticalAlignment="Center">
                <TextBlock.Style>
                  <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                    <Setter Property="Text" Value="&#xE70E;" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding TasksExpanded}" Value="True">
                        <Setter Property="Text" Value="&#xE70D;" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
              <TextBlock Style="{StaticResource Icon}" Text="&#xE9D5;" FontSize="12" Foreground="{DynamicResource Accent}" Margin="0,0,8,0" VerticalAlignment="Center" />
              <TextBlock Text="{Binding TasksSummary}" FontWeight="SemiBold" VerticalAlignment="Center" />
              <TextBlock Text="{Binding CurrentTask}" Style="{StaticResource Muted}" Margin="10,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
          </ToggleButton>
        </DockPanel>
        <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Visibility="{Binding TasksExpanded, Converter={StaticResource BoolToVis}}">
          <ItemsControl ItemsSource="{Binding Tasks}" Margin="10,0,10,6">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <DockPanel Margin="0,2">
                  <TextBlock x:Name="Glyph" DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE739;" FontSize="12" Margin="0,1,8,0" VerticalAlignment="Top" />
                  <TextBlock x:Name="TaskText" Text="{Binding Display}" TextWrapping="Wrap" />
                </DockPanel>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding Status}" Value="completed">
                    <Setter TargetName="Glyph" Property="Text" Value="&#xE73A;" />
                    <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource AddedGreen}" />
                    <Setter TargetName="TaskText" Property="TextDecorations" Value="Strikethrough" />
                    <Setter TargetName="TaskText" Property="Opacity" Value="0.6" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding Status}" Value="in_progress">
                    <Setter TargetName="Glyph" Property="Text" Value="&#xE768;" />
                    <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Accent}" />
                    <Setter TargetName="TaskText" Property="FontWeight" Value="SemiBold" />
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </StackPanel>
    </Border>

    <!-- Question card: Claude's multiple-choice questions (never shown at the same time as the approval card) -->
    <Border Grid.Row="4" Margin="10,4,10,8" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource Accent}"
            Background="{DynamicResource UserBubble}" Padding="12,10"
            Visibility="{Binding HasPendingQuestions, Converter={StaticResource BoolToVis}}">
      <StackPanel>
        <StackPanel Orientation="Horizontal">
          <TextBlock Style="{StaticResource Icon}" Text="&#xE897;" Foreground="{DynamicResource Accent}" FontSize="13" Margin="0,0,8,0" />
          <TextBlock Text="{Binding QuestionCardTitle}" FontWeight="SemiBold" VerticalAlignment="Center" AutomationProperties.LiveSetting="Assertive" />
        </StackPanel>
        <ScrollViewer MaxHeight="380" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,6,0,0">
          <ItemsControl ItemsSource="{Binding PendingQuestions}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="0,4,0,8">
                  <Border HorizontalAlignment="Left" CornerRadius="4" Padding="6,1" Margin="0,0,0,4"
                          Background="{DynamicResource SubtleBorder}"
                          Visibility="{Binding HasHeader, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding Header}" FontSize="10.5" FontWeight="SemiBold" />
                  </Border>
                  <TextBlock Text="{Binding Question}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Hint}" Style="{StaticResource Muted}" FontSize="11" Margin="0,2,0,6" />
                  <ItemsControl ItemsSource="{Binding Options}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <ToggleButton Style="{StaticResource OptionCard}" IsChecked="{Binding IsSelected, Mode=TwoWay}">
                          <StackPanel>
                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" FontSize="11.5" TextWrapping="Wrap"
                                       Margin="0,1,0,0" Visibility="{Binding HasDescription, Converter={StaticResource BoolToVis}}" />
                          </StackPanel>
                        </ToggleButton>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Grid>
                    <TextBox AutomationProperties.Name="Your own answer" Style="{StaticResource Field}" Text="{Binding OtherText, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="Other: type your own answer…" IsHitTestVisible="False" Style="{StaticResource Muted}" Margin="8,5,0,0">
                      <TextBlock.Visibility>
                        <Binding Path="OtherText" Converter="{StaticResource EmptyToVis}" />
                      </TextBlock.Visibility>
                    </TextBlock>
                  </Grid>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
          <Button Style="{StaticResource OutlineButton}" Content="Skip" Click="OnSkipQuestions" ToolTip="Let Claude continue without your answer" />
          <Button Style="{StaticResource PrimaryButton}" Content="Submit" Click="OnSubmitAnswers" IsEnabled="{Binding CanSubmitAnswers}" />
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- Approval card for actions that change the repository -->
    <Border Grid.Row="4" Margin="10,4,10,8" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource Amber}"
            Background="{DynamicResource AmberTint}" Padding="12,10"
            Visibility="{Binding HasPendingApproval, Converter={StaticResource BoolToVis}}">
      <StackPanel>
        <StackPanel Orientation="Horizontal">
          <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" Foreground="{DynamicResource Amber}" FontSize="13" Margin="0,0,8,0" />
          <TextBlock Text="Claude wants to make a change" FontWeight="SemiBold" VerticalAlignment="Center" AutomationProperties.LiveSetting="Assertive" />
        </StackPanel>
        <TextBlock Text="{Binding ApprovalTitle}" FontFamily="{StaticResource MonoFont}" FontSize="12" TextWrapping="Wrap" Margin="21,4,0,0" />
        <Border Margin="0,8,0,0" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource SubtleBorder}"
                Background="{DynamicResource {x:Static vsshell:VsBrushes.WindowKey}}"
                Visibility="{Binding HasApprovalDetail, Converter={StaticResource BoolToVis}}">
          <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,4">
            <ItemsControl ItemsSource="{Binding ApprovalLines}" ItemTemplate="{StaticResource DiffLineTemplate}" />
          </ScrollViewer>
        </Border>
        <!-- The same edit with a checkbox per block of changes, when it has several -->
        <Border Margin="0,8,0,0" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource SubtleBorder}"
                Background="{DynamicResource {x:Static vsshell:VsBrushes.WindowKey}}"
                Visibility="{Binding IsReviewingBlocks, Converter={StaticResource BoolToVis}}">
          <StackPanel>
            <DockPanel Margin="8,5,8,3">
              <TextBlock Style="{StaticResource Icon}" Text="&#xE73A;" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center" />
              <TextBlock Text="{Binding ReviewSummary}" Style="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" />
            </DockPanel>
            <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,0,4">
              <ItemsControl ItemsSource="{Binding ApprovalReview.Lines}" ItemTemplate="{StaticResource ReviewLineTemplate}" />
            </ScrollViewer>
          </StackPanel>
        </Border>
        <DockPanel Margin="0,10,0,0">
        <Button DockPanel.Dock="Left" Style="{StaticResource OutlineButton}" Margin="0" Click="OnOpenApprovalDiff"
                ToolTip="Open the whole file, before and after, in Visual Studio's diff viewer"
                Visibility="{Binding HasApprovalChange, Converter={StaticResource BoolToVis}}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE8F1;" FontSize="11" Margin="0,0,6,0" />
            <TextBlock Text="Open diff" />
          </StackPanel>
        </Button>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Style="{StaticResource OutlineButton}" Content="Deny" Click="OnDeny" />
          <Button Style="{StaticResource OutlineButton}" Content="{Binding AllowAllLabel}" Click="OnAllowAll" IsEnabled="{Binding CanApprove}"
                  Visibility="{Binding CanAllowAll, Converter={StaticResource BoolToVis}}" />
          <Button Style="{StaticResource PrimaryButton}" Content="Allow" Click="OnAllow" IsEnabled="{Binding CanApprove}" />
        </StackPanel>
        </DockPanel>
      </StackPanel>
    </Border>

    <!-- Activity indicator -->
    <ProgressBar Grid.Row="5" Height="2" Margin="12,0,12,0" IsIndeterminate="{Binding IsBusy}" BorderThickness="0"
                 Background="Transparent" Foreground="{DynamicResource Accent}"
                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />

    <!-- Completions for "/" commands and "@" file mentions, shown just above the composer. -->
    <Popup x:Name="SuggestionPopup" Grid.Row="6" PlacementTarget="{Binding ElementName=Composer}" Placement="Top"
           AllowsTransparency="True" StaysOpen="True" Width="{Binding ActualWidth, ElementName=Composer}">
      <Border Margin="0,0,0,4" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource SubtleBorder}" Padding="4"
              Background="{DynamicResource {x:Static vsshell:VsBrushes.WindowKey}}">
        <ListBox x:Name="SuggestionList" AutomationProperties.Name="Suggestions" MaxHeight="260" BorderThickness="0" Background="Transparent" Focusable="False"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" PreviewMouseLeftButtonUp="OnSuggestionClicked">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="Focusable" Value="False" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" CornerRadius="5" Padding="8,4" Background="Transparent">
                      <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverTint}" />
                      </Trigger>
                      <Trigger Property="IsSelected" Value="True">
                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource UserBubble}" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding Detail}" Style="{StaticResource Muted}" FontSize="11" Margin="12,0,0,0"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="260" />
                <TextBlock Text="{Binding Display}" FontFamily="{StaticResource MonoFont}" FontSize="12" TextTrimming="CharacterEllipsis" />
              </DockPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>
    </Popup>

    <!-- Composer: attachment chips, then the prompt. Enter sends, Shift+Enter inserts a new line. Images and files can be pasted or dropped. -->
    <Border x:Name="Composer" Grid.Row="6" Margin="10,4,10,4" CornerRadius="12" BorderThickness="1" AllowDrop="True"
            PreviewDragOver="OnComposerDragOver" PreviewDrop="OnComposerDrop"
            Background="{DynamicResource {x:Static vsshell:VsBrushes.WindowKey}}">
      <Border.Style>
        <Style TargetType="Border">
          <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorder}" />
          <Style.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
            </Trigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <StackPanel Margin="12,8,8,8">
      <WrapPanel Margin="0,0,0,2" Visibility="{Binding HasAttachments, Converter={StaticResource BoolToVis}}">
        <ContentControl Content="{Binding ActiveFile}" ContentTemplate="{StaticResource AttachmentChip}"
                        Visibility="{Binding HasActiveFile, Converter={StaticResource BoolToVis}}" />
        <ItemsControl ItemsSource="{Binding Attachments}" ItemTemplate="{StaticResource AttachmentChip}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
      </WrapPanel>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBox x:Name="PromptBox" AutomationProperties.Name="Message to Claude" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="40" MaxHeight="200" AllowDrop="True"
                 VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" PreviewKeyDown="OnPromptKeyDown"
                 TextChanged="OnPromptTextChanged" LostKeyboardFocus="OnPromptLostFocus" SelectionChanged="OnPromptSelectionChanged"
                 Background="Transparent" BorderThickness="0" Padding="0" FontSize="13"
                 Foreground="{DynamicResource {x:Static vsshell:VsBrushes.WindowTextKey}}"
                 CaretBrush="{DynamicResource {x:Static vsshell:VsBrushes.WindowTextKey}}">
          <TextBox.Template>
            <ControlTemplate TargetType="TextBox">
              <ScrollViewer x:Name="PART_ContentHost" />
            </ControlTemplate>
          </TextBox.Template>
        </TextBox>
        <TextBlock Text="Ask Claude about this repository… (/ for commands, @ to mention a file)" IsHitTestVisible="False" FontSize="13" Margin="2,0,0,0"
                   TextTrimming="CharacterEllipsis" Foreground="{DynamicResource {x:Static vsshell:VsBrushes.GrayTextKey}}">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding Text, ElementName=PromptBox}" Value="">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
        <Grid Grid.Column="1" VerticalAlignment="Bottom" Margin="8,0,0,0">
          <Button Style="{StaticResource RoundButton}" Content="&#xE724;" AutomationProperties.Name="Send (Enter)" ToolTip="Send (Enter)" Click="OnSend"
                  Visibility="{Binding IsIdle, Converter={StaticResource BoolToVis}}" />
          <Button Style="{StaticResource RoundButton}" Content="&#xE71A;" AutomationProperties.Name="Stop" ToolTip="Stop" Click="OnStop"
                  Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
        </Grid>
      </Grid>
      </StackPanel>
    </Border>

    <!-- Footer: status and keyboard hint -->
    <DockPanel Grid.Row="7" Margin="14,0,14,8">
      <TextBlock DockPanel.Dock="Right" Style="{StaticResource Muted}" FontSize="11" Text="Enter to send · Shift+Enter for new line · ↑ for history"
                 ToolTip="Type / for commands and @ to mention a file. Paste or drop images to attach them. Ctrl+F searches the chat." />
      <TextBlock Style="{StaticResource Muted}" FontSize="11" Text="{Binding Status}" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="Status"
                 ToolTip="{Binding Status}" Margin="0,0,12,0" />
    </DockPanel>
    </Grid>
  </Grid>
</UserControl>
