<UserControl x:Class="ClaudeForVS.ToolWindows.ClaudeChatControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vsshell="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
             xmlns:platform="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
             xmlns:md="clr-namespace:ClaudeForVS.Markdown"
             xmlns:local="clr-namespace:ClaudeForVS.ToolWindows"
             Background="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBackgroundKey}}"
             Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"
             FontFamily="{DynamicResource {x:Static vsshell:VsFonts.EnvironmentFontFamilyKey}}"
             FontSize="12">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Theme.xaml" />
      </ResourceDictionary.MergedDictionaries>

    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <local:EmptyToVisibilityConverter x:Key="EmptyToVis" />

    <!-- Whole-row toggle used by collapsible transcript rows. -->
    <Style x:Key="RowToggle" TargetType="ToggleButton">
      <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="Bd" Background="Transparent" CornerRadius="6">
              <ContentPresenter HorizontalAlignment="Stretch" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverTint}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Cursor" Value="Arrow" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- One line of tool output or diff. -->
    <DataTemplate x:Key="DiffLineTemplate">
      <Border x:Name="Bg" Padding="8,0">
        <TextBlock x:Name="LineText" Text="{Binding Text}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" TextWrapping="Wrap" />
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Kind}" Value="Added">
          <Setter TargetName="Bg" Property="Background" Value="{StaticResource AddedTint}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Kind}" Value="Removed">
          <Setter TargetName="Bg" Property="Background" Value="{StaticResource RemovedTint}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Kind}" Value="Hunk">
          <Setter TargetName="LineText" Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.GrayTextKey}}" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- ===== Transcript templates ===== -->
    <DataTemplate x:Key="UserTemplate">
      <!-- Right-aligned so the bubble shrinks to fit short messages and grows (up to the margin) for long ones. -->
      <Border Margin="48,10,0,6" HorizontalAlignment="Right" CornerRadius="12,12,4,12" Padding="12,8"
              Background="{StaticResource UserBubble}" BorderThickness="1" BorderBrush="{StaticResource UserBubbleBorder}">
        <md:MarkdownView Markdown="{Binding Text, Mode=OneWay}" FontSize="13"
                         Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}" />
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="AssistantTemplate">
      <Border Margin="0,10,24,6" HorizontalAlignment="Left" CornerRadius="12,12,12,4" Padding="12,10"
              Background="{StaticResource SubtleFill}" BorderThickness="1" BorderBrush="{StaticResource SubtleBorder}">
        <StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
            <Border Width="20" Height="20" CornerRadius="10" Background="{StaticResource Accent}">
              <TextBlock Text="✻" Foreground="White" FontSize="12" FontFamily="Segoe UI Symbol"
                         HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" />
            </Border>
            <TextBlock Text="Claude" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
          <md:MarkdownView Markdown="{Binding Text, Mode=OneWay}" FontSize="13"
                           Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}" />
        </StackPanel>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="ThinkingTemplate">
      <StackPanel Margin="0,4,0,2">
        <ToggleButton x:Name="Toggle" Style="{StaticResource RowToggle}">
          <DockPanel Margin="6,4">
            <TextBlock x:Name="Chevron" DockPanel.Dock="Right" Style="{StaticResource Icon}" FontSize="9" Text="&#xE76C;" />
            <TextBlock Style="{StaticResource Icon}" FontSize="12" Text="&#xEA80;" Margin="0,0,8,0" />
            <TextBlock Text="Thinking" FontStyle="Italic" Style="{StaticResource Muted}" VerticalAlignment="Center" />
          </DockPanel>
        </ToggleButton>
        <TextBlock x:Name="Body" Text="{Binding Text}" Style="{StaticResource Muted}" FontStyle="Italic"
                   TextWrapping="Wrap" Margin="26,2,6,4" Visibility="Collapsed" />
      </StackPanel>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsChecked, ElementName=Toggle}" Value="True">
          <Setter TargetName="Body" Property="Visibility" Value="Visible" />
          <Setter TargetName="Chevron" Property="Text" Value="&#xE70D;" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate x:Key="ToolTemplate">
      <Border Margin="0,2" CornerRadius="6" BorderThickness="1" BorderBrush="{StaticResource SubtleBorder}" Background="{StaticResource SubtleFill}">
        <StackPanel>
          <ToggleButton x:Name="Toggle" Style="{StaticResource RowToggle}" IsEnabled="{Binding HasDetail}">
            <DockPanel Margin="8,5">
              <TextBlock x:Name="Chevron" DockPanel.Dock="Right" Style="{StaticResource Icon}" FontSize="9" Text="&#xE76C;"
                         Margin="8,0,0,0" Visibility="{Binding HasDetail, Converter={StaticResource BoolToVis}}" />
              <TextBlock x:Name="Glyph" Style="{StaticResource Icon}" FontSize="12" Text="&#xE756;" Margin="0,0,8,0" />
              <TextBlock x:Name="Title" Text="{Binding Header}" ToolTip="{Binding Header}" FontFamily="{StaticResource MonoFont}"
                         FontSize="11.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            </DockPanel>
          </ToggleButton>
          <Border x:Name="Details" Visibility="Collapsed" BorderThickness="0,1,0,0" BorderBrush="{StaticResource SubtleBorder}" Padding="0,4">
            <ItemsControl ItemsSource="{Binding DetailLines}" ItemTemplate="{StaticResource DiffLineTemplate}" />
          </Border>
        </StackPanel>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsChecked, ElementName=Toggle}" Value="True">
          <Setter TargetName="Details" Property="Visibility" Value="Visible" />
          <Setter TargetName="Chevron" Property="Text" Value="&#xE70D;" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Activity}" Value="Read">
          <Setter TargetName="Glyph" Property="Text" Value="&#xE8A5;" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Activity}" Value="Edit">
          <Setter TargetName="Glyph" Property="Text" Value="&#xE70F;" />
          <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource Accent}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Activity}" Value="Create">
          <Setter TargetName="Glyph" Property="Text" Value="&#xE710;" />
          <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource Accent}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Activity}" Value="Declined">
          <Setter TargetName="Glyph" Property="Text" Value="&#xE711;" />
          <Setter TargetName="Title" Property="TextDecorations" Value="Strikethrough" />
          <Setter TargetName="Title" Property="Opacity" Value="0.6" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Activity}" Value="Failed">
          <Setter TargetName="Glyph" Property="Text" Value="&#xE7BA;" />
          <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource Amber}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Activity}" Value="Search">
          <Setter TargetName="Glyph" Property="Text" Value="&#xE721;" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Activity}" Value="Web">
          <Setter TargetName="Glyph" Property="Text" Value="&#xE774;" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Activity}" Value="Other">
          <Setter TargetName="Glyph" Property="Text" Value="&#xE946;" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Activity}" Value="Question">
          <Setter TargetName="Glyph" Property="Text" Value="&#xE897;" />
          <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource Accent}" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate x:Key="ErrorTemplate">
      <Border Margin="0,6" CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource ErrorRed}" Background="{StaticResource ErrorTint}" Padding="10,8">
        <DockPanel>
          <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE783;" FontSize="14"
                     Foreground="{StaticResource ErrorRed}" VerticalAlignment="Top" Margin="0,1,10,0" />
          <StackPanel>
            <TextBlock Text="{Binding Header}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="0,2,0,0" Style="{StaticResource Muted}" />
          </StackPanel>
        </DockPanel>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="NoticeTemplate">
      <Grid Margin="0,10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Height="1" Background="{StaticResource SubtleBorder}" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="{Binding Header}" Style="{StaticResource Muted}" FontSize="11" Margin="10,0" />
        <Border Grid.Column="2" Height="1" Background="{StaticResource SubtleBorder}" VerticalAlignment="Center" />
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="UsageTemplate">
      <TextBlock Text="{Binding Header}" Style="{StaticResource Muted}" FontSize="11" HorizontalAlignment="Right" Margin="0,0,0,8" />
    </DataTemplate>

    <local:ChatEntryTemplateSelector x:Key="EntrySelector"
                                     User="{StaticResource UserTemplate}"
                                     Assistant="{StaticResource AssistantTemplate}"
                                     Thinking="{StaticResource ThinkingTemplate}"
                                     Tool="{StaticResource ToolTemplate}"
                                     Error="{StaticResource ErrorTemplate}"
                                     Notice="{StaticResource NoticeTemplate}"
                                     Usage="{StaticResource UsageTemplate}" />
    </ResourceDictionary>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Header: repository and model chips, actions; then the always-visible usage strip -->
    <StackPanel Grid.Row="0">
    <DockPanel Margin="10,8,10,6">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button Style="{StaticResource IconButton}" Content="&#xE710;" ToolTip="New chat" Click="OnNewChat" />
        <Button Style="{StaticResource IconButton}" Content="&#xE713;" ToolTip="Settings" Click="OnOpenSettings" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
        <Button Style="{StaticResource OutlineButton}" Margin="0" Padding="10,4" ToolTip="{Binding RepoTooltip}" Click="OnOpenSettings">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" FontSize="12" Foreground="{StaticResource Accent}" />
            <TextBlock Text="{Binding RepoName}" FontWeight="SemiBold" Margin="7,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Style="{StaticResource OutlineButton}" Margin="6,0,0,0" Padding="10,4" ToolTip="Model and effort" Click="OnOpenSettings">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE945;" FontSize="12" Foreground="{StaticResource Accent}" />
            <TextBlock Text="{Binding ModelSummary}" Margin="7,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </StackPanel>
    </DockPanel>

    <!-- Usage strip: plan limits (Claude Code) or session tokens and rate limits (Claude API). Always shown. -->
    <Border Margin="10,0,10,8">
      <Grid>
        <ItemsControl ItemsSource="{Binding UsageMeters}" Visibility="{Binding HasUsageMeters, Converter={StaticResource BoolToVis}}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Rows="1" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Margin="0,0,6,0" Padding="10,6,10,6" CornerRadius="8" BorderThickness="1"
                      BorderBrush="{StaticResource SubtleBorder}" Background="{StaticResource SubtleFill}"
                      ToolTip="{Binding Detail}">
                <StackPanel>
                  <DockPanel>
                    <TextBlock x:Name="ValueText" DockPanel.Dock="Right" Text="{Binding Value}" FontWeight="SemiBold" FontSize="11.5" />
                    <TextBlock Text="{Binding Label}" Style="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,0,6,0" />
                  </DockPanel>
                  <ProgressBar x:Name="Bar" Style="{StaticResource MeterBar}" Value="{Binding BarValue, Mode=OneWay}" Margin="0,5,0,3"
                               Visibility="{Binding HasBar, Converter={StaticResource BoolToVis}}" />
                  <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" FontSize="10.5" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                </StackPanel>
              </Border>
              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Severity}" Value="Warning">
                  <Setter TargetName="Bar" Property="Foreground" Value="{StaticResource Amber}" />
                  <Setter TargetName="ValueText" Property="Foreground" Value="{StaticResource Amber}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="Critical">
                  <Setter TargetName="Bar" Property="Foreground" Value="{StaticResource ErrorRed}" />
                  <Setter TargetName="ValueText" Property="Foreground" Value="{StaticResource ErrorRed}" />
                </DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <DockPanel Margin="2,0,0,0">
          <DockPanel.Style>
            <Style TargetType="DockPanel">
              <Style.Triggers>
                <DataTrigger Binding="{Binding HasUsageMeters}" Value="True">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </DockPanel.Style>
          <TextBlock Style="{StaticResource Icon}" Text="&#xE9D9;" FontSize="11" Margin="0,0,6,0" />
          <TextBlock Text="{Binding UsageEmptyText}" Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" />
        </DockPanel>
      </Grid>
    </Border>
    </StackPanel>

    <!-- Shown until the selected engine is ready (API key saved, or Claude Code installed and signed in) -->
    <Border Grid.Row="1" Margin="10,0,10,8" Padding="12,9" CornerRadius="8" BorderThickness="1"
            BorderBrush="{StaticResource Amber}" Background="{StaticResource AmberTint}"
            Visibility="{Binding HasSetupMessage, Converter={StaticResource BoolToVis}}">
      <DockPanel>
        <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Open settings" Click="OnOpenSettings" />
        <TextBlock Style="{StaticResource Icon}" Text="&#xE8D7;" Foreground="{StaticResource Amber}" FontSize="13" Margin="0,0,10,0" />
        <TextBlock Text="{Binding SetupMessage}" TextWrapping="Wrap" VerticalAlignment="Center" />
      </DockPanel>
    </Border>

    <!-- Transcript -->
    <ScrollViewer x:Name="Transcript" Grid.Row="2"
                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  ScrollChanged="OnTranscriptScrollChanged" PreviewMouseWheel="OnTranscriptMouseWheel">
      <ItemsControl ItemsSource="{Binding Messages}" ItemTemplateSelector="{StaticResource EntrySelector}" Margin="12,0,12,8" />
    </ScrollViewer>

    <!-- Question card: Claude's multiple-choice questions (never shown at the same time as the approval card) -->
    <Border Grid.Row="3" Margin="10,4,10,8" CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource Accent}"
            Background="{StaticResource UserBubble}" Padding="12,10"
            Visibility="{Binding HasPendingQuestions, Converter={StaticResource BoolToVis}}">
      <StackPanel>
        <StackPanel Orientation="Horizontal">
          <TextBlock Style="{StaticResource Icon}" Text="&#xE897;" Foreground="{StaticResource Accent}" FontSize="13" Margin="0,0,8,0" />
          <TextBlock Text="{Binding QuestionCardTitle}" FontWeight="SemiBold" VerticalAlignment="Center" />
        </StackPanel>
        <ScrollViewer MaxHeight="380" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,6,0,0">
          <ItemsControl ItemsSource="{Binding PendingQuestions}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="0,4,0,8">
                  <Border HorizontalAlignment="Left" CornerRadius="4" Padding="6,1" Margin="0,0,0,4"
                          Background="{StaticResource SubtleBorder}"
                          Visibility="{Binding HasHeader, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding Header}" FontSize="10.5" FontWeight="SemiBold" />
                  </Border>
                  <TextBlock Text="{Binding Question}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Hint}" Style="{StaticResource Muted}" FontSize="11" Margin="0,2,0,6" />
                  <ItemsControl ItemsSource="{Binding Options}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <ToggleButton Style="{StaticResource OptionCard}" IsChecked="{Binding IsSelected, Mode=TwoWay}">
                          <StackPanel>
                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" FontSize="11.5" TextWrapping="Wrap"
                                       Margin="0,1,0,0" Visibility="{Binding HasDescription, Converter={StaticResource BoolToVis}}" />
                          </StackPanel>
                        </ToggleButton>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Grid>
                    <TextBox Style="{StaticResource Field}" Text="{Binding OtherText, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="Other: type your own answer…" IsHitTestVisible="False" Style="{StaticResource Muted}" Margin="8,5,0,0">
                      <TextBlock.Visibility>
                        <Binding Path="OtherText" Converter="{StaticResource EmptyToVis}" />
                      </TextBlock.Visibility>
                    </TextBlock>
                  </Grid>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
          <Button Style="{StaticResource OutlineButton}" Content="Skip" Click="OnSkipQuestions" ToolTip="Let Claude continue without your answer" />
          <Button Style="{StaticResource PrimaryButton}" Content="Submit" Click="OnSubmitAnswers" IsEnabled="{Binding CanSubmitAnswers}" />
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- Approval card for actions that change the repository -->
    <Border Grid.Row="3" Margin="10,4,10,8" CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource Amber}"
            Background="{StaticResource AmberTint}" Padding="12,10"
            Visibility="{Binding HasPendingApproval, Converter={StaticResource BoolToVis}}">
      <StackPanel>
        <StackPanel Orientation="Horizontal">
          <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" Foreground="{StaticResource Amber}" FontSize="13" Margin="0,0,8,0" />
          <TextBlock Text="Claude wants to make a change" FontWeight="SemiBold" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Text="{Binding ApprovalTitle}" FontFamily="{StaticResource MonoFont}" FontSize="12" TextWrapping="Wrap" Margin="21,4,0,0" />
        <Border Margin="0,8,0,0" CornerRadius="6" BorderThickness="1" BorderBrush="{StaticResource SubtleBorder}"
                Background="{DynamicResource {x:Static vsshell:VsBrushes.WindowKey}}"
                Visibility="{Binding HasApprovalDetail, Converter={StaticResource BoolToVis}}">
          <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,4">
            <ItemsControl ItemsSource="{Binding ApprovalLines}" ItemTemplate="{StaticResource DiffLineTemplate}" />
          </ScrollViewer>
        </Border>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
          <Button Style="{StaticResource OutlineButton}" Content="Deny" Click="OnDeny" />
          <Button Style="{StaticResource OutlineButton}" Content="{Binding AllowAllLabel}" Click="OnAllowAll"
                  Visibility="{Binding CanAllowAll, Converter={StaticResource BoolToVis}}" />
          <Button Style="{StaticResource PrimaryButton}" Content="Allow" Click="OnAllow" />
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- Activity indicator -->
    <ProgressBar Grid.Row="4" Height="2" Margin="12,0,12,0" IsIndeterminate="{Binding IsBusy}" BorderThickness="0"
                 Background="Transparent" Foreground="{StaticResource Accent}"
                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />

    <!-- Composer: Enter sends, Shift+Enter inserts a new line -->
    <Border Grid.Row="5" Margin="10,4,10,4" CornerRadius="12" BorderThickness="1"
            Background="{DynamicResource {x:Static vsshell:VsBrushes.WindowKey}}">
      <Border.Style>
        <Style TargetType="Border">
          <Setter Property="BorderBrush" Value="{StaticResource SubtleBorder}" />
          <Style.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
            </Trigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <Grid Margin="12,8,8,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBox x:Name="PromptBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="40" MaxHeight="200"
                 VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" PreviewKeyDown="OnPromptKeyDown"
                 Background="Transparent" BorderThickness="0" Padding="0" FontSize="13"
                 Foreground="{DynamicResource {x:Static vsshell:VsBrushes.WindowTextKey}}"
                 CaretBrush="{DynamicResource {x:Static vsshell:VsBrushes.WindowTextKey}}">
          <TextBox.Template>
            <ControlTemplate TargetType="TextBox">
              <ScrollViewer x:Name="PART_ContentHost" />
            </ControlTemplate>
          </TextBox.Template>
        </TextBox>
        <TextBlock Text="Ask Claude about this repository…" IsHitTestVisible="False" FontSize="13" Margin="2,0,0,0"
                   Foreground="{DynamicResource {x:Static vsshell:VsBrushes.GrayTextKey}}">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding Text, ElementName=PromptBox}" Value="">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
        <Grid Grid.Column="1" VerticalAlignment="Bottom" Margin="8,0,0,0">
          <Button Style="{StaticResource RoundButton}" Content="&#xE724;" ToolTip="Send (Enter)" Click="OnSend"
                  Visibility="{Binding IsIdle, Converter={StaticResource BoolToVis}}" />
          <Button Style="{StaticResource RoundButton}" Content="&#xE71A;" ToolTip="Stop" Click="OnStop"
                  Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
        </Grid>
      </Grid>
    </Border>

    <!-- Footer: status and keyboard hint -->
    <DockPanel Grid.Row="6" Margin="14,0,14,8">
      <TextBlock DockPanel.Dock="Right" Style="{StaticResource Muted}" FontSize="11" Text="Enter to send · Shift+Enter for new line" />
      <TextBlock Style="{StaticResource Muted}" FontSize="11" Text="{Binding Status}" TextTrimming="CharacterEllipsis"
                 ToolTip="{Binding Status}" Margin="0,0,12,0" />
    </DockPanel>
  </Grid>
</UserControl>
