<UserControl x:Class="ClaudeForVS.ToolWindows.ClaudeTasksControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vsshell="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
             Background="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBackgroundKey}}"
             Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"
             FontFamily="{DynamicResource {x:Static vsshell:VsFonts.EnvironmentFontFamilyKey}}"
             FontSize="12">
  <!-- DataContext is the chat's ClaudeChatViewModel (null until the chat has opened); the details pane's is the selected ToolTask. -->
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Theme.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <BooleanToVisibilityConverter x:Key="BoolToVis" />

      <Style x:Key="TaskRow" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ListBoxItem">
              <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="8,5" Margin="4,1">
                <ContentPresenter />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverTint}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                  <Setter TargetName="Bd" Property="Background" Value="{DynamicResource UserBubble}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- The icon for a task, by what it is and how it went. -->
      <Style x:Key="TaskGlyph" TargetType="TextBlock" BasedOn="{StaticResource Icon}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Text" Value="&#xE946;" />
        <Style.Triggers>
          <DataTrigger Binding="{Binding Activity}" Value="Shell">
            <Setter Property="Text" Value="&#xE756;" />
          </DataTrigger>
          <DataTrigger Binding="{Binding Activity}" Value="Failed">
            <Setter Property="Text" Value="&#xE7BA;" />
            <Setter Property="Foreground" Value="{DynamicResource Amber}" />
          </DataTrigger>
          <DataTrigger Binding="{Binding Activity}" Value="Declined">
            <Setter Property="Text" Value="&#xE711;" />
          </DataTrigger>
          <DataTrigger Binding="{Binding IsRunning}" Value="True">
            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
          </DataTrigger>
        </Style.Triggers>
      </Style>
    </ResourceDictionary>
  </UserControl.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="260" MinWidth="120" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" MinWidth="160" />
    </Grid.ColumnDefinitions>

    <!-- Tasks, newest first. -->
    <DockPanel Grid.Column="0" Visibility="{Binding HasItems, ElementName=List, Converter={StaticResource BoolToVis}}">
      <DockPanel DockPanel.Dock="Top" Margin="10,8,6,4">
        <Button DockPanel.Dock="Right" Style="{StaticResource MiniButton}" Content="Clear finished" Click="OnClearFinished"
                ToolTip="Take the tasks that have finished off this list" />
        <TextBlock Text="Tasks" FontWeight="SemiBold" VerticalAlignment="Center" />
      </DockPanel>
      <ListBox x:Name="List" ItemsSource="{Binding ToolTasks}" ItemContainerStyle="{StaticResource TaskRow}"
               Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               SelectionChanged="OnSelectionChanged" AutomationProperties.Name="Tasks">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <DockPanel>
              <TextBlock DockPanel.Dock="Left" Style="{StaticResource TaskGlyph}" VerticalAlignment="Top" Margin="0,2,8,0" />
              <StackPanel>
                <TextBlock Text="{Binding Title}" ToolTip="{Binding Title}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding StatusText}" Style="{StaticResource Muted}" FontSize="11" Margin="0,1,0,0" />
              </StackPanel>
            </DockPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>

    <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent"
                  BorderThickness="1,0,0,0" BorderBrush="{DynamicResource SubtleBorder}" ResizeBehavior="PreviousAndNext"
                  Visibility="{Binding HasItems, ElementName=List, Converter={StaticResource BoolToVis}}" />

    <!-- The selected task: what it is, how it's going, and its steps or output. -->
    <DockPanel Grid.Column="2" DataContext="{Binding SelectedItem, ElementName=List}"
               Visibility="{Binding HasItems, ElementName=List, Converter={StaticResource BoolToVis}}">
      <DockPanel DockPanel.Dock="Top" Margin="12,8,10,8">
        <Button DockPanel.Dock="Right" Style="{StaticResource OutlineButton}" Content="Stop" VerticalAlignment="Top" Click="OnStop"
                ToolTip="Stop this; Claude carries on without it" Visibility="{Binding CanStop, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}" />
        <StackPanel>
          <DockPanel>
            <TextBlock DockPanel.Dock="Left" Style="{StaticResource TaskGlyph}" VerticalAlignment="Top" Margin="0,2,8,0" />
            <TextBlock Text="{Binding Title}" FontFamily="{StaticResource MonoFont}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
          </DockPanel>
          <TextBlock Text="{Binding StatusText}" Style="{StaticResource Muted}" FontSize="11" Margin="20,2,0,0" />
        </StackPanel>
      </DockPanel>
      <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource SubtleBorder}">
        <!-- Virtualized: a command's output can run to thousands of lines, and only those on screen are laid out. -->
        <ItemsControl x:Name="OutputLines" ItemsSource="{Binding DetailLines}" ItemTemplate="{StaticResource DiffLineTemplate}"
                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel"
                      ScrollViewer.ScrollChanged="OnOutputScrollChanged">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <VirtualizingStackPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.Template>
            <ControlTemplate TargetType="ItemsControl">
              <ScrollViewer x:Name="Output" CanContentScroll="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="4,6">
                <ItemsPresenter />
              </ScrollViewer>
            </ControlTemplate>
          </ItemsControl.Template>
        </ItemsControl>
      </Border>
    </DockPanel>

    <!-- Nothing to show yet. -->
    <TextBlock Grid.Column="0" Grid.ColumnSpan="3" TextWrapping="Wrap" TextAlignment="Center"
               HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="320" Margin="16"
               Text="Subagents and commands Claude runs in this chat show up here, with what they're doing as they work.">
      <TextBlock.Style>
        <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
          <Setter Property="Visibility" Value="Collapsed" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding HasItems, ElementName=List}" Value="False">
              <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </TextBlock.Style>
    </TextBlock>
  </Grid>
</UserControl>
