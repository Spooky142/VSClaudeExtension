<platform:DialogWindow x:Class="ClaudeForVS.ToolWindows.SettingsDialog"
                       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:vsshell="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
                       xmlns:platform="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
                       Title="Claude Settings"
                       Width="480" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
                       WindowStartupLocation="CenterOwner"
                       Background="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBackgroundKey}}"
                       Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"
                       FontFamily="{DynamicResource {x:Static vsshell:VsFonts.EnvironmentFontFamilyKey}}"
                       FontSize="12">
  <platform:DialogWindow.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Theme.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Margin" Value="0,18,0,8" />
        <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}" />
      </Style>
      <Style x:Key="CardTitle" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="13" />
      </Style>
      <Style x:Key="CardNote" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,2,0,0" />
      </Style>
      <Style x:Key="Price" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style>
    </ResourceDictionary>
  </platform:DialogWindow.Resources>

  <StackPanel x:Name="Root" Margin="22,16,22,18">
    <TextBlock Text="Settings" FontSize="20" FontWeight="SemiBold" />

    <!-- Engine -->
    <TextBlock Style="{StaticResource SectionTitle}" Text="Engine" />
    <RadioButton x:Name="ApiEngineRadio" GroupName="Engine" Style="{StaticResource CardRadio}" Checked="OnEngineChanged">
      <StackPanel>
        <DockPanel>
          <TextBlock DockPanel.Dock="Right" Style="{StaticResource Price}" Text="Pay per token" />
          <TextBlock Style="{StaticResource CardTitle}" Text="Claude API" />
        </DockPanel>
        <TextBlock Style="{StaticResource CardNote}" Text="Uses an Anthropic API key, with this extension's own git and file tools." />
      </StackPanel>
    </RadioButton>
    <RadioButton x:Name="CodeEngineRadio" GroupName="Engine" Style="{StaticResource CardRadio}" Checked="OnEngineChanged">
      <StackPanel>
        <DockPanel>
          <TextBlock DockPanel.Dock="Right" Style="{StaticResource Price}" Text="Pro / Max plan" />
          <TextBlock Style="{StaticResource CardTitle}" Text="Claude Code" />
        </DockPanel>
        <TextBlock Style="{StaticResource CardNote}" Text="Runs the Claude Code CLI on this machine, signed in with your own plan, using Claude Code's tools." />
      </StackPanel>
    </RadioButton>
    <Border x:Name="CodePanel" CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource SubtleBorder}"
            Background="{StaticResource SubtleFill}" Padding="12,10" Visibility="Collapsed">
      <StackPanel>
        <DockPanel>
          <TextBlock x:Name="CodeStatusIcon" DockPanel.Dock="Left" Style="{StaticResource Icon}" FontSize="13" Margin="0,1,8,0"
                     VerticalAlignment="Top" Text="&#xE895;" />
          <TextBlock x:Name="CodeStatusText" TextWrapping="Wrap" Text="Checking Claude Code…" />
        </DockPanel>
        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
          <Button x:Name="InstallButton" Style="{StaticResource PrimaryButton}" Margin="0,0,6,0" Content="Install Claude Code" Click="OnInstallClaudeCode" />
          <Button x:Name="SignInButton" Style="{StaticResource PrimaryButton}" Margin="0,0,6,0" Content="Sign in" Click="OnSignIn" />
          <Button x:Name="RefreshButton" Style="{StaticResource OutlineButton}" Margin="0" Content="Check again" Click="OnRefreshStatus" />
        </StackPanel>
        <TextBlock Style="{StaticResource CardNote}" Margin="0,8,0,0"
                   Text="Install runs Anthropic's official installer in a PowerShell window. Sign in opens Anthropic's own login page; this extension never sees your Claude credentials." />
      </StackPanel>
    </Border>

    <!-- Model -->
    <TextBlock Style="{StaticResource SectionTitle}" Text="Model" />
    <RadioButton x:Name="OpusRadio" GroupName="Model" Style="{StaticResource CardRadio}" Checked="OnModelChanged">
      <StackPanel>
        <DockPanel>
          <TextBlock x:Name="OpusPrice" DockPanel.Dock="Right" Style="{StaticResource Price}" Text="$4 / $20 per MTok" />
          <TextBlock Style="{StaticResource CardTitle}" Text="Opus 5.5" />
        </DockPanel>
        <TextBlock Style="{StaticResource CardNote}" Text="Most capable. Best for complex, multi-step changes." />
      </StackPanel>
    </RadioButton>
    <RadioButton x:Name="SonnetRadio" GroupName="Model" Style="{StaticResource CardRadio}" Checked="OnModelChanged">
      <StackPanel>
        <DockPanel>
          <TextBlock x:Name="SonnetPrice" DockPanel.Dock="Right" Style="{StaticResource Price}" Text="$2 / $10 per MTok" />
          <TextBlock Style="{StaticResource CardTitle}" Text="Sonnet 5.5" />
        </DockPanel>
        <TextBlock Style="{StaticResource CardNote}" Text="Fast and highly capable. Great for everyday work." />
      </StackPanel>
    </RadioButton>
    <RadioButton x:Name="HaikuRadio" GroupName="Model" Style="{StaticResource CardRadio}" Checked="OnModelChanged">
      <StackPanel>
        <DockPanel>
          <TextBlock x:Name="HaikuPrice" DockPanel.Dock="Right" Style="{StaticResource Price}" Text="$1 / $5 per MTok" />
          <TextBlock Style="{StaticResource CardTitle}" Text="Haiku 4.5" />
        </DockPanel>
        <TextBlock Style="{StaticResource CardNote}" Text="Fastest and cheapest. Good for quick questions." />
      </StackPanel>
    </RadioButton>
    <TextBlock x:Name="ModelChangeNote" Style="{StaticResource CardNote}" Visibility="Collapsed"
               Text="Changing the engine or model starts a new chat." Foreground="{StaticResource Amber}" />

    <!-- Effort -->
    <TextBlock Style="{StaticResource SectionTitle}" Text="Effort" />
    <Border CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource SubtleBorder}" Background="{StaticResource SubtleFill}">
      <UniformGrid Rows="1" Columns="5">
        <RadioButton x:Name="EffortLow" GroupName="Effort" Style="{StaticResource SegmentRadio}" Content="Low" Checked="OnEffortChanged" />
        <RadioButton x:Name="EffortMedium" GroupName="Effort" Style="{StaticResource SegmentRadio}" Content="Medium" Checked="OnEffortChanged" />
        <RadioButton x:Name="EffortHigh" GroupName="Effort" Style="{StaticResource SegmentRadio}" Content="High" Checked="OnEffortChanged" />
        <RadioButton x:Name="EffortXHigh" GroupName="Effort" Style="{StaticResource SegmentRadio}" Content="Extra high" Checked="OnEffortChanged" />
        <RadioButton x:Name="EffortMax" GroupName="Effort" Style="{StaticResource SegmentRadio}" Content="Max" Checked="OnEffortChanged" />
      </UniformGrid>
    </Border>
    <TextBlock x:Name="EffortHint" Style="{StaticResource CardNote}" Margin="2,6,0,0" />

    <!-- Repository -->
    <TextBlock Style="{StaticResource SectionTitle}" Text="Repository" />
    <DockPanel>
      <Button DockPanel.Dock="Right" Style="{StaticResource OutlineButton}" Content="Use solution" Click="OnUseSolution"
              ToolTip="Use the git repository of the open solution" />
      <Button DockPanel.Dock="Right" Style="{StaticResource OutlineButton}" Content="Browse…" Click="OnBrowse" />
      <TextBox x:Name="RepoBox" Style="{StaticResource Field}" TextChanged="OnRepoChanged" />
    </DockPanel>
    <DockPanel Margin="2,6,0,0">
      <TextBlock x:Name="RepoHintIcon" DockPanel.Dock="Left" Style="{StaticResource Icon}" FontSize="11" Margin="0,1,6,0" VerticalAlignment="Top" />
      <TextBlock x:Name="RepoHint" Style="{StaticResource CardNote}" Margin="0" />
    </DockPanel>

    <!-- API key (Claude API engine only) -->
    <StackPanel x:Name="ApiKeySection">
      <TextBlock Style="{StaticResource SectionTitle}" Text="Anthropic API key" />
      <PasswordBox x:Name="ApiKeyBox" Style="{StaticResource PasswordField}" />
      <TextBlock x:Name="ApiKeyHint" Style="{StaticResource CardNote}" Margin="2,6,0,0" />
    </StackPanel>

    <!-- Buttons -->
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
      <Button Style="{StaticResource OutlineButton}" Content="Cancel" IsCancel="True" MinWidth="80" />
      <Button Style="{StaticResource PrimaryButton}" Content="Save" IsDefault="True" MinWidth="80" Click="OnSave" />
    </StackPanel>
  </StackPanel>
</platform:DialogWindow>
