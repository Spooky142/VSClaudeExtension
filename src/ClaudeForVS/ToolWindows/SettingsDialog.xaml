<platform:DialogWindow x:Class="ClaudeForVS.ToolWindows.SettingsDialog"
                       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:vsshell="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
                       xmlns:platform="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
                       Title="Claude Settings"
                       Width="480" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
                       WindowStartupLocation="CenterOwner"
                       Background="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBackgroundKey}}"
                       Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"
                       FontFamily="{DynamicResource {x:Static vsshell:VsFonts.EnvironmentFontFamilyKey}}"
                       FontSize="12">
  <platform:DialogWindow.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Theme.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Margin" Value="0,18,0,8" />
        <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}" />
      </Style>
      <Style x:Key="CardTitle" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="13" />
      </Style>
      <Style x:Key="CardNote" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,2,0,0" />
      </Style>
      <Style x:Key="Price" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style>
    </ResourceDictionary>
  </platform:DialogWindow.Resources>

  <StackPanel x:Name="Root" Margin="22,16,22,18">
    <TextBlock Text="Settings" FontSize="20" FontWeight="SemiBold" />

    <!-- Engine -->
    <TextBlock Style="{StaticResource SectionTitle}" Text="Engine" />
    <RadioButton x:Name="ApiEngineRadio" GroupName="Engine" Style="{StaticResource CardRadio}" Checked="OnEngineChanged">
      <StackPanel>
        <DockPanel>
          <TextBlock DockPanel.Dock="Right" Style="{StaticResource Price}" Text="Pay per token" />
          <TextBlock Style="{StaticResource CardTitle}" Text="Claude API" />
        </DockPanel>
        <TextBlock Style="{StaticResource CardNote}" Text="Uses an Anthropic API key, with this extension's own git and file tools." />
      </StackPanel>
    </RadioButton>
    <RadioButton x:Name="CodeEngineRadio" GroupName="Engine" Style="{StaticResource CardRadio}" Checked="OnEngineChanged">
      <StackPanel>
        <DockPanel>
          <TextBlock DockPanel.Dock="Right" Style="{StaticResource Price}" Text="Pro / Max plan" />
          <TextBlock Style="{StaticResource CardTitle}" Text="Claude Code" />
        </DockPanel>
        <TextBlock Style="{StaticResource CardNote}" Text="Runs the Claude Code CLI on this machine, signed in with your own plan, using Claude Code's tools." />
      </StackPanel>
    </RadioButton>
    <Border x:Name="CodePanel" CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource SubtleBorder}"
            Background="{StaticResource SubtleFill}" Padding="12,10" Visibility="Collapsed">
      <StackPanel>
        <DockPanel>
          <TextBlock x:Name="CodeStatusIcon" DockPanel.Dock="Left" Style="{StaticResource Icon}" FontSize="13" Margin="0,1,8,0"
                     VerticalAlignment="Top" Text="&#xE895;" />
          <TextBlock x:Name="CodeStatusText" TextWrapping="Wrap" Text="Checking Claude Code…" />
        </DockPanel>
        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
          <Button x:Name="InstallButton" Style="{StaticResource PrimaryButton}" Margin="0,0,6,0" Content="Install Claude Code" Click="OnInstallClaudeCode" />
          <Button x:Name="SignInButton" Style="{StaticResource PrimaryButton}" Margin="0,0,6,0" Content="Sign in" Click="OnSignIn" />
          <Button x:Name="RefreshButton" Style="{StaticResource OutlineButton}" Margin="0" Content="Check again" Click="OnRefreshStatus" />
        </StackPanel>
        <TextBlock Style="{StaticResource CardNote}" Margin="0,8,0,0"
                   Text="Install runs Anthropic's official installer in a PowerShell window. Sign in opens Anthropic's own login page. The extension never stores your Claude credentials; it only reads Claude Code's sign-in token to show your plan usage." />
      </StackPanel>
    </Border>

    <!-- Model -->
    <TextBlock Style="{StaticResource SectionTitle}" Text="Model" />
    <RadioButton x:Name="OpusRadio" GroupName="Model" Style="{StaticResource CardRadio}" Checked="OnModelChanged">
      <StackPanel>
        <DockPanel>
          <TextBlock x:Name="OpusPrice" DockPanel.Dock="Right" Style="{StaticResource Price}" Text="$4 / $20 per MTok" />
          <TextBlock x:Name="OpusName" Style="{StaticResource CardTitle}" Text="Opus" />
        </DockPanel>
        <TextBlock Style="{StaticResource CardNote}" Text="Most capable. Best for complex, multi-step changes." />
      </StackPanel>
    </RadioButton>
    <RadioButton x:Name="SonnetRadio" GroupName="Model" Style="{StaticResource CardRadio}" Checked="OnModelChanged">
      <StackPanel>
        <DockPanel>
          <TextBlock x:Name="SonnetPrice" DockPanel.Dock="Right" Style="{StaticResource Price}" Text="$2 / $10 per MTok" />
          <TextBlock x:Name="SonnetName" Style="{StaticResource CardTitle}" Text="Sonnet" />
        </DockPanel>
        <TextBlock Style="{StaticResource CardNote}" Text="Fast and highly capable. Great for everyday work." />
      </StackPanel>
    </RadioButton>
    <RadioButton x:Name="HaikuRadio" GroupName="Model" Style="{StaticResource CardRadio}" Checked="OnModelChanged">
      <StackPanel>
        <DockPanel>
          <TextBlock x:Name="HaikuPrice" DockPanel.Dock="Right" Style="{StaticResource Price}" Text="$0.10 / $0.50 per MTok"
                     ToolTip="For prompts up to 100K tokens; longer prompts are $0.50 / $2.50 per MTok." />
          <TextBlock x:Name="HaikuName" Style="{StaticResource CardTitle}" Text="Haiku" />
        </DockPanel>
        <TextBlock Style="{StaticResource CardNote}" Text="Fastest and cheapest. Good for quick questions." />
      </StackPanel>
    </RadioButton>
    <TextBlock x:Name="ModelChangeNote" Style="{StaticResource CardNote}" Visibility="Collapsed"
               Text="Changing the engine or model starts a new chat." Foreground="{StaticResource Amber}" />

    <!-- Effort -->
    <TextBlock Style="{StaticResource SectionTitle}" Text="Effort" />
    <Border CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource SubtleBorder}" Background="{StaticResource SubtleFill}">
      <UniformGrid Rows="1" Columns="5">
        <RadioButton x:Name="EffortLow" GroupName="Effort" Style="{StaticResource SegmentRadio}" Content="Low" Checked="OnEffortChanged" />
        <RadioButton x:Name="EffortMedium" GroupName="Effort" Style="{StaticResource SegmentRadio}" Content="Medium" Checked="OnEffortChanged" />
        <RadioButton x:Name="EffortHigh" GroupName="Effort" Style="{StaticResource SegmentRadio}" Content="High" Checked="OnEffortChanged" />
        <RadioButton x:Name="EffortXHigh" GroupName="Effort" Style="{StaticResource SegmentRadio}" Content="Extra high" Checked="OnEffortChanged" />
        <RadioButton x:Name="EffortMax" GroupName="Effort" Style="{StaticResource SegmentRadio}" Content="Max" Checked="OnEffortChanged" />
      </UniformGrid>
    </Border>
    <TextBlock x:Name="EffortHint" Style="{StaticResource CardNote}" Margin="2,6,0,0" />

    <!-- Mode -->
    <TextBlock Style="{StaticResource SectionTitle}" Text="Mode" />
    <Border CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource SubtleBorder}" Background="{StaticResource SubtleFill}">
      <UniformGrid Rows="1" Columns="3">
        <RadioButton x:Name="ModeAuto" GroupName="Mode" Style="{StaticResource SegmentRadio}" Content="Auto" Checked="OnModeChanged" />
        <RadioButton x:Name="ModePlan" GroupName="Mode" Style="{StaticResource SegmentRadio}" Content="Plan" Checked="OnModeChanged" />
        <RadioButton x:Name="ModeCoding" GroupName="Mode" Style="{StaticResource SegmentRadio}" Content="Coding" Checked="OnModeChanged" />
      </UniformGrid>
    </Border>
    <TextBlock x:Name="ModeHint" Style="{StaticResource CardNote}" Margin="2,6,0,0" />

    <!-- Subagents: the model the separate helpers Claude starts for scoped jobs run on -->
    <TextBlock Style="{StaticResource SectionTitle}" Text="Subagent model" />
    <Border CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource SubtleBorder}" Background="{StaticResource SubtleFill}">
      <UniformGrid Rows="1" Columns="4">
        <RadioButton x:Name="SubagentAuto" GroupName="Subagent" Style="{StaticResource SegmentRadio}" Content="Automatic" Checked="OnSubagentChanged" />
        <RadioButton x:Name="SubagentOpus" GroupName="Subagent" Style="{StaticResource SegmentRadio}" Content="Opus" Checked="OnSubagentChanged" />
        <RadioButton x:Name="SubagentSonnet" GroupName="Subagent" Style="{StaticResource SegmentRadio}" Content="Sonnet" Checked="OnSubagentChanged" />
        <RadioButton x:Name="SubagentHaiku" GroupName="Subagent" Style="{StaticResource SegmentRadio}" Content="Haiku" Checked="OnSubagentChanged" />
      </UniformGrid>
    </Border>
    <TextBlock x:Name="SubagentHint" Style="{StaticResource CardNote}" Margin="2,6,0,0" />

    <!-- Repository -->
    <TextBlock Style="{StaticResource SectionTitle}" Text="Repository" />
    <DockPanel>
      <Button DockPanel.Dock="Right" Style="{StaticResource OutlineButton}" Content="Use solution" Click="OnUseSolution"
              ToolTip="Use the git repository of the open solution" />
      <Button DockPanel.Dock="Right" Style="{StaticResource OutlineButton}" Content="Browse…" Click="OnBrowse" />
      <TextBox x:Name="RepoBox" AutomationProperties.Name="Repository folder" Style="{StaticResource Field}" TextChanged="OnRepoChanged" />
    </DockPanel>
    <DockPanel Margin="2,6,0,0">
      <TextBlock x:Name="RepoHintIcon" DockPanel.Dock="Left" Style="{StaticResource Icon}" FontSize="11" Margin="0,1,6,0" VerticalAlignment="Top" />
      <TextBlock x:Name="RepoHint" Style="{StaticResource CardNote}" Margin="0" />
    </DockPanel>

    <!-- Tidying what Claude writes (both engines) -->
    <TextBlock Style="{StaticResource SectionTitle}" Text="Code style" />
    <CheckBox x:Name="FormatChangedBox" Content="Format the code Claude writes to match my editor settings"
              AutomationProperties.Name="Format the code Claude writes to match my editor settings" />
    <TextBlock Style="{StaticResource CardNote}" Margin="22,2,0,0"
               Text="When Claude finishes a reply, the lines it changed in C# and Visual Basic files are formatted by Visual Studio's formatter using your .editorconfig. Lines it didn't touch, and files with unsaved changes, are left as they are." />

    <!-- Telling the user when Claude needs them -->
    <TextBlock Style="{StaticResource SectionTitle}" Text="Notifications" />
    <CheckBox x:Name="NotificationsBox" Content="Show a Windows notification when Claude needs me or finishes"
              AutomationProperties.Name="Show a Windows notification when Claude needs me or finishes" />
    <TextBlock Style="{StaticResource CardNote}" Margin="22,2,0,0"
               Text="Only while Visual Studio isn't in front or the chat window is hidden. Click the notification to go back to the chat. The status bar and the flashing taskbar button tell you either way." />

    <!-- This extension's own updates, from its GitHub releases -->
    <TextBlock Style="{StaticResource SectionTitle}" Text="Updates" />
    <CheckBox x:Name="ExtensionUpdatesBox" Content="Check for new versions of this extension"
              AutomationProperties.Name="Check for new versions of this extension" />
    <TextBlock x:Name="ExtensionUpdatesHint" Style="{StaticResource CardNote}" Margin="22,2,0,0" />

    <!-- Commands remembered with "Always allow" on the approval card, for the repository above -->
    <TextBlock Style="{StaticResource SectionTitle}" Text="Always-allowed commands" />
    <ItemsControl x:Name="AllowedCommandsList">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Border Margin="0,0,0,4" CornerRadius="6" BorderThickness="1" BorderBrush="{StaticResource SubtleBorder}"
                  Background="{StaticResource SubtleFill}" Padding="10,3,3,3">
            <DockPanel>
              <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE74D;" Width="24" Height="24"
                      ToolTip="Ask again before running this" Click="OnRemoveAllowedCommand" />
              <TextBlock Text="{Binding Display}" ToolTip="{Binding Rule}" FontFamily="{StaticResource MonoFont}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <TextBlock x:Name="AllowedCommandsHint" Style="{StaticResource CardNote}" Margin="2,2,0,0" />

    <!-- Claude API engine's extras: hooks and a spending limit -->
    <StackPanel x:Name="ApiOptionsSection">
      <TextBlock Style="{StaticResource SectionTitle}" Text="Claude API options" />
      <CheckBox x:Name="NewestModelsBox" Content="Use the newest model versions"
                AutomationProperties.Name="Use the newest model versions" Checked="OnNewestModelsChanged" Unchecked="OnNewestModelsChanged" />
      <TextBlock x:Name="NewestModelsHint" Style="{StaticResource CardNote}" Margin="22,2,0,12" />
      <CheckBox x:Name="RunHooksBox" Content="Run hooks from Claude Code's settings files"
                AutomationProperties.Name="Run hooks from Claude Code's settings files" />
      <TextBlock Style="{StaticResource CardNote}" Margin="22,2,0,0"
                 Text="Hooks are commands from ~/.claude/settings.json and the repository's .claude settings that run before and after tools, when you send a message, and when Claude finishes. Ones from the repository ask for your approval first. Claude Code runs its own hooks whatever this says." />
      <DockPanel Margin="0,12,0,0">
        <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,8,0" Text="Spending limit per chat ($)" />
        <TextBox x:Name="SpendLimitBox" Style="{StaticResource Field}" Width="90" HorizontalAlignment="Left"
                 AutomationProperties.Name="Spending limit per chat in dollars" />
      </DockPanel>
      <TextBlock Style="{StaticResource CardNote}" Margin="2,6,0,0"
                 Text="Claude stops and asks before going past this estimated cost in one chat. Leave it empty for no limit." />
      <DockPanel Margin="0,12,0,0">
        <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,8,0" Text="Summarize chats at (thousand tokens)" />
        <TextBox x:Name="CompactAtBox" Style="{StaticResource Field}" Width="90" HorizontalAlignment="Left"
                 AutomationProperties.Name="Summarize chats at this many thousand tokens" />
      </DockPanel>
      <TextBlock Style="{StaticResource CardNote}" Margin="2,6,0,0"
                 Text="Every request re-reads the whole conversation, so summarizing it earlier keeps long chats cheaper. Leave it empty to summarize only when the 1M-token window is nearly full." />
    </StackPanel>

    <!-- API key (Claude API engine only) -->
    <StackPanel x:Name="ApiKeySection">
      <TextBlock Style="{StaticResource SectionTitle}" Text="Anthropic API key" />
      <PasswordBox x:Name="ApiKeyBox" AutomationProperties.Name="Anthropic API key" Style="{StaticResource PasswordField}" />
      <TextBlock x:Name="ApiKeyHint" Style="{StaticResource CardNote}" Margin="2,6,0,0" />
    </StackPanel>

    <!-- Buttons -->
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
      <Button Style="{StaticResource OutlineButton}" Content="Cancel" IsCancel="True" MinWidth="80" />
      <Button Style="{StaticResource PrimaryButton}" Content="Save" IsDefault="True" MinWidth="80" Click="OnSave" />
    </StackPanel>
  </StackPanel>
</platform:DialogWindow>
