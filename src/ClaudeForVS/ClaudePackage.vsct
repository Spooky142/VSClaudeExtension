<?xml version="1.0" encoding="utf-8"?>
<CommandTable xmlns="http://schemas.microsoft.com/VisualStudio/2005-10-18/CommandTable" xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <Extern href="stdidcmd.h" />
  <Extern href="vsshlids.h" />

  <Commands package="guidClaudePackage">
    <Menus>
      <!-- "Claude" submenu on the code editor's context menu. -->
      <Menu guid="guidClaudeCmdSet" id="EditorClaudeMenu" priority="0x0100" type="Menu">
        <Parent guid="guidClaudeCmdSet" id="EditorContextGroup" />
        <Strings>
          <ButtonText>Claude</ButtonText>
        </Strings>
      </Menu>
    </Menus>

    <Groups>
      <Group guid="guidClaudeCmdSet" id="ClaudeMenuGroup" priority="0x0600">
        <Parent guid="guidSHLMainMenu" id="IDM_VS_MENU_TOOLS" />
      </Group>
      <Group guid="guidClaudeCmdSet" id="EditorContextGroup" priority="0x0600">
        <Parent guid="guidSHLMainMenu" id="IDM_VS_CTXT_CODEWIN" />
      </Group>
      <Group guid="guidClaudeCmdSet" id="EditorClaudeMenuGroup" priority="0x0100">
        <Parent guid="guidClaudeCmdSet" id="EditorClaudeMenu" />
      </Group>
      <Group guid="guidClaudeCmdSet" id="ErrorListGroup" priority="0x0600">
        <Parent guid="guidSHLMainMenu" id="IDM_VS_CTXT_ERRORLIST" />
      </Group>
    </Groups>

    <Buttons>
      <Button guid="guidClaudeCmdSet" id="ShowClaudeWindowCommandId" priority="0x0100" type="Button">
        <Parent guid="guidClaudeCmdSet" id="ClaudeMenuGroup" />
        <Strings>
          <ButtonText>Claude Chat</ButtonText>
        </Strings>
      </Button>

      <Button guid="guidClaudeCmdSet" id="AskAboutSelectionCommandId" priority="0x0100" type="Button">
        <Parent guid="guidClaudeCmdSet" id="EditorClaudeMenuGroup" />
        <Strings>
          <ButtonText>Ask Claude About This</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidClaudeCmdSet" id="ExplainCommandId" priority="0x0200" type="Button">
        <Parent guid="guidClaudeCmdSet" id="EditorClaudeMenuGroup" />
        <Strings>
          <ButtonText>Explain</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidClaudeCmdSet" id="FixCommandId" priority="0x0300" type="Button">
        <Parent guid="guidClaudeCmdSet" id="EditorClaudeMenuGroup" />
        <Strings>
          <ButtonText>Fix</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidClaudeCmdSet" id="WriteTestsCommandId" priority="0x0400" type="Button">
        <Parent guid="guidClaudeCmdSet" id="EditorClaudeMenuGroup" />
        <Strings>
          <ButtonText>Write Tests</ButtonText>
        </Strings>
      </Button>

      <Button guid="guidClaudeCmdSet" id="FixErrorsCommandId" priority="0x0100" type="Button">
        <Parent guid="guidClaudeCmdSet" id="ErrorListGroup" />
        <Strings>
          <ButtonText>Fix with Claude</ButtonText>
        </Strings>
      </Button>
    </Buttons>
  </Commands>

  <KeyBindings>
    <!-- Opens (or focuses) the chat from anywhere. Rebind in Tools > Options > Environment > Keyboard ("Tools.ClaudeChat"). -->
    <KeyBinding guid="guidClaudeCmdSet" id="ShowClaudeWindowCommandId" editor="guidVSStd97" key1="C" mod1="Control Shift Alt" />
  </KeyBindings>

  <Symbols>
    <GuidSymbol name="guidClaudePackage" value="{4b0f1f5e-7a3c-4d52-9f1e-2c6a8b9d0e41}" />
    <GuidSymbol name="guidClaudeCmdSet" value="{9e3d2b1a-5c47-4f8e-a6b2-1d0c3e5f7a92}">
      <IDSymbol name="ClaudeMenuGroup" value="0x1020" />
      <IDSymbol name="EditorContextGroup" value="0x1021" />
      <IDSymbol name="EditorClaudeMenu" value="0x1022" />
      <IDSymbol name="EditorClaudeMenuGroup" value="0x1023" />
      <IDSymbol name="ErrorListGroup" value="0x1024" />
      <IDSymbol name="ShowClaudeWindowCommandId" value="0x0100" />
      <IDSymbol name="AskAboutSelectionCommandId" value="0x0101" />
      <IDSymbol name="ExplainCommandId" value="0x0102" />
      <IDSymbol name="FixCommandId" value="0x0103" />
      <IDSymbol name="WriteTestsCommandId" value="0x0104" />
      <IDSymbol name="FixErrorsCommandId" value="0x0105" />
    </GuidSymbol>
  </Symbols>
</CommandTable>
