<?xml version="1.0" encoding="utf-8"?>
<CommandTable xmlns="http://schemas.microsoft.com/VisualStudio/2005-10-18/CommandTable" xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <Extern href="stdidcmd.h" />
  <Extern href="vsshlids.h" />

  <Commands package="guidClaudePackage">
    <Menus>
      <!-- "Claude" submenu on the code editor's context menu. -->
      <Menu guid="guidClaudeCmdSet" id="EditorClaudeMenu" priority="0x0100" type="Menu">
        <Parent guid="guidClaudeCmdSet" id="EditorContextGroup" />
        <Strings>
          <ButtonText>Claude</ButtonText>
        </Strings>
      </Menu>
    </Menus>

    <Groups>
      <Group guid="guidClaudeCmdSet" id="ClaudeMenuGroup" priority="0x0600">
        <Parent guid="guidSHLMainMenu" id="IDM_VS_MENU_TOOLS" />
      </Group>
      <Group guid="guidClaudeCmdSet" id="EditorContextGroup" priority="0x0600">
        <Parent guid="guidSHLMainMenu" id="IDM_VS_CTXT_CODEWIN" />
      </Group>
      <Group guid="guidClaudeCmdSet" id="EditorClaudeMenuGroup" priority="0x0100">
        <Parent guid="guidClaudeCmdSet" id="EditorClaudeMenu" />
      </Group>
      <Group guid="guidClaudeCmdSet" id="ErrorListGroup" priority="0x0600">
        <Parent guid="guidSHLMainMenu" id="IDM_VS_CTXT_ERRORLIST" />
      </Group>

      <!-- Test Explorer's context menu (its menu ID isn't in the SDK headers; see TestWindowCommands in Visual Studio's TestWindow assembly). -->
      <Group guid="guidClaudeCmdSet" id="TestExplorerGroup" priority="0x0600">
        <Parent guid="guidTestExplorerCmdSet" id="TestExplorerContextMenu" />
      </Group>

      <!-- Solution Explorer: files, folders, projects, the solution, and multiple selections. -->
      <Group guid="guidClaudeCmdSet" id="SolutionExplorerGroup" priority="0x0600">
        <Parent guid="guidSHLMainMenu" id="IDM_VS_CTXT_ITEMNODE" />
      </Group>

      <!-- Git: the top-level Git menu, and the "..." actions menu in the Git Changes window. -->
      <Group guid="guidClaudeCmdSet" id="GitMenuGroup" priority="0x0600">
        <Parent guid="guidGitCmdSet" id="GitRootMenu" />
      </Group>
      <Group guid="guidClaudeCmdSet" id="GitChangesGroup" priority="0x0600">
        <Parent guid="guidGitCmdSet" id="GitChangesActionsMenu" />
      </Group>

      <!-- The Debug menu. -->
      <Group guid="guidClaudeCmdSet" id="DebugMenuGroup" priority="0x0600">
        <Parent guid="guidSHLMainMenu" id="IDM_VS_MENU_DEBUG" />
      </Group>
    </Groups>

    <Buttons>
      <Button guid="guidClaudeCmdSet" id="ShowClaudeWindowCommandId" priority="0x0100" type="Button">
        <Parent guid="guidClaudeCmdSet" id="ClaudeMenuGroup" />
        <Strings>
          <ButtonText>Claude Chat</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidClaudeCmdSet" id="NewChatWindowCommandId" priority="0x0200" type="Button">
        <Parent guid="guidClaudeCmdSet" id="ClaudeMenuGroup" />
        <Strings>
          <ButtonText>New Claude Chat Window</ButtonText>
        </Strings>
      </Button>

      <Button guid="guidClaudeCmdSet" id="EditInlineCommandId" priority="0x0050" type="Button">
        <Parent guid="guidClaudeCmdSet" id="EditorClaudeMenuGroup" />
        <Strings>
          <ButtonText>Edit with Claude Here</ButtonText>
          <CanonicalName>Edit.EditWithClaude</CanonicalName>
          <LocCanonicalName>Edit.EditWithClaude</LocCanonicalName>
        </Strings>
      </Button>
      <Button guid="guidClaudeCmdSet" id="AskAboutSelectionCommandId" priority="0x0100" type="Button">
        <Parent guid="guidClaudeCmdSet" id="EditorClaudeMenuGroup" />
        <Strings>
          <ButtonText>Ask Claude About This</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidClaudeCmdSet" id="ExplainCommandId" priority="0x0200" type="Button">
        <Parent guid="guidClaudeCmdSet" id="EditorClaudeMenuGroup" />
        <Strings>
          <ButtonText>Explain</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidClaudeCmdSet" id="FixCommandId" priority="0x0300" type="Button">
        <Parent guid="guidClaudeCmdSet" id="EditorClaudeMenuGroup" />
        <Strings>
          <ButtonText>Fix</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidClaudeCmdSet" id="WriteTestsCommandId" priority="0x0400" type="Button">
        <Parent guid="guidClaudeCmdSet" id="EditorClaudeMenuGroup" />
        <Strings>
          <ButtonText>Write Tests</ButtonText>
        </Strings>
      </Button>

      <Button guid="guidClaudeCmdSet" id="FixErrorsCommandId" priority="0x0100" type="Button">
        <Parent guid="guidClaudeCmdSet" id="ErrorListGroup" />
        <Strings>
          <ButtonText>Fix with Claude</ButtonText>
        </Strings>
      </Button>

      <Button guid="guidClaudeCmdSet" id="FixTestsCommandId" priority="0x0100" type="Button">
        <Parent guid="guidClaudeCmdSet" id="TestExplorerGroup" />
        <Strings>
          <ButtonText>Fix with Claude</ButtonText>
        </Strings>
      </Button>

      <Button guid="guidClaudeCmdSet" id="AddToClaudeCommandId" priority="0x0100" type="Button">
        <Parent guid="guidClaudeCmdSet" id="SolutionExplorerGroup" />
        <Strings>
          <ButtonText>Add to Claude</ButtonText>
        </Strings>
      </Button>

      <Button guid="guidClaudeCmdSet" id="WriteCommitMessageCommandId" priority="0x0100" type="Button">
        <Parent guid="guidClaudeCmdSet" id="GitMenuGroup" />
        <Strings>
          <ButtonText>Write Commit Message with Claude</ButtonText>
        </Strings>
      </Button>

      <!-- Always enabled, so it works before the package has loaded; it says so if the debugger isn't paused. -->
      <Button guid="guidClaudeCmdSet" id="AskAboutDebugStateCommandId" priority="0x0100" type="Button">
        <Parent guid="guidClaudeCmdSet" id="DebugMenuGroup" />
        <Strings>
          <ButtonText>Ask Claude About This Break</ButtonText>
        </Strings>
      </Button>
    </Buttons>
  </Commands>

  <!-- The same groups on more menus. -->
  <CommandPlacements>
    <CommandPlacement guid="guidClaudeCmdSet" id="SolutionExplorerGroup" priority="0x0600">
      <Parent guid="guidSHLMainMenu" id="IDM_VS_CTXT_FOLDERNODE" />
    </CommandPlacement>
    <CommandPlacement guid="guidClaudeCmdSet" id="SolutionExplorerGroup" priority="0x0600">
      <Parent guid="guidSHLMainMenu" id="IDM_VS_CTXT_PROJNODE" />
    </CommandPlacement>
    <CommandPlacement guid="guidClaudeCmdSet" id="SolutionExplorerGroup" priority="0x0600">
      <Parent guid="guidSHLMainMenu" id="IDM_VS_CTXT_SOLNNODE" />
    </CommandPlacement>
    <CommandPlacement guid="guidClaudeCmdSet" id="SolutionExplorerGroup" priority="0x0600">
      <Parent guid="guidSHLMainMenu" id="IDM_VS_CTXT_XPROJ_MULTIITEM" />
    </CommandPlacement>
    <CommandPlacement guid="guidClaudeCmdSet" id="SolutionExplorerGroup" priority="0x0600">
      <Parent guid="guidSHLMainMenu" id="IDM_VS_CTXT_XPROJ_PROJITEM" />
    </CommandPlacement>
    <CommandPlacement guid="guidClaudeCmdSet" id="SolutionExplorerGroup" priority="0x0600">
      <Parent guid="guidSHLMainMenu" id="IDM_VS_CTXT_XPROJ_MULTIPROJ" />
    </CommandPlacement>
    <CommandPlacement guid="guidClaudeCmdSet" id="WriteCommitMessageCommandId" priority="0x0100">
      <Parent guid="guidClaudeCmdSet" id="GitChangesGroup" />
    </CommandPlacement>
    <CommandPlacement guid="guidClaudeCmdSet" id="AskAboutDebugStateCommandId" priority="0x0500">
      <Parent guid="guidClaudeCmdSet" id="EditorClaudeMenuGroup" />
    </CommandPlacement>
  </CommandPlacements>

  <KeyBindings>
    <!-- Opens (or focuses) the chat from anywhere. Rebind in Tools > Options > Environment > Keyboard ("Tools.ClaudeChat"). -->
    <KeyBinding guid="guidClaudeCmdSet" id="ShowClaudeWindowCommandId" editor="guidVSStd97" key1="C" mod1="Control Shift Alt" />

    <!-- Alt+/ in the code editor: edit the code at the caret in place ("Edit.EditWithClaude"). -->
    <KeyBinding guid="guidClaudeCmdSet" id="EditInlineCommandId" editor="guidTextEditor" key1="VK_OEM_2" mod1="Alt" />
  </KeyBindings>

  <Symbols>
    <GuidSymbol name="guidClaudePackage" value="{4b0f1f5e-7a3c-4d52-9f1e-2c6a8b9d0e41}" />
    <GuidSymbol name="guidClaudeCmdSet" value="{9e3d2b1a-5c47-4f8e-a6b2-1d0c3e5f7a92}">
      <IDSymbol name="ClaudeMenuGroup" value="0x1020" />
      <IDSymbol name="EditorContextGroup" value="0x1021" />
      <IDSymbol name="EditorClaudeMenu" value="0x1022" />
      <IDSymbol name="EditorClaudeMenuGroup" value="0x1023" />
      <IDSymbol name="ErrorListGroup" value="0x1024" />
      <IDSymbol name="TestExplorerGroup" value="0x1025" />
      <IDSymbol name="SolutionExplorerGroup" value="0x1026" />
      <IDSymbol name="GitMenuGroup" value="0x1027" />
      <IDSymbol name="GitChangesGroup" value="0x1028" />
      <IDSymbol name="DebugMenuGroup" value="0x1029" />
      <IDSymbol name="ShowClaudeWindowCommandId" value="0x0100" />
      <IDSymbol name="AskAboutSelectionCommandId" value="0x0101" />
      <IDSymbol name="ExplainCommandId" value="0x0102" />
      <IDSymbol name="FixCommandId" value="0x0103" />
      <IDSymbol name="WriteTestsCommandId" value="0x0104" />
      <IDSymbol name="FixErrorsCommandId" value="0x0105" />
      <IDSymbol name="NewChatWindowCommandId" value="0x0106" />
      <IDSymbol name="FixTestsCommandId" value="0x0107" />
      <IDSymbol name="AddToClaudeCommandId" value="0x0108" />
      <IDSymbol name="WriteCommitMessageCommandId" value="0x0109" />
      <IDSymbol name="AskAboutDebugStateCommandId" value="0x010A" />
      <IDSymbol name="EditInlineCommandId" value="0x010B" />
    </GuidSymbol>

    <!-- The code editor's key binding scope. -->
    <GuidSymbol name="guidTextEditor" value="{8B382828-6202-11d1-8870-0000F87579D2}" />

    <!-- Test Explorer's command set and context menu. -->
    <GuidSymbol name="guidTestExplorerCmdSet" value="{1e198c22-5980-4e7e-92f3-f73168d1fb63}">
      <IDSymbol name="TestExplorerContextMenu" value="0x0002" />
    </GuidSymbol>

    <!-- Visual Studio's Git command set: the Git menu, and Git Changes' actions menu. -->
    <GuidSymbol name="guidGitCmdSet" value="{57735d06-c920-4415-a2e0-7d6e6fbdfa99}">
      <IDSymbol name="GitRootMenu" value="0xF000" />
      <IDSymbol name="GitChangesActionsMenu" value="0xF010" />
    </GuidSymbol>
  </Symbols>
</CommandTable>
